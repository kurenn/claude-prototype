{"slug": "claude", "name": "Claude", "category": "AI & LLM Platforms", "summary": "Anthropic's AI assistant. Warm terracotta accent, clean editorial layout", "description": "A warm-canvas editorial interface for Anthropic's Claude product. The system anchors on a tinted cream canvas with serif display headlines, warm coral CTAs, and dark navy product surfaces (code editor mockups, model showcase cards). Brand voltage comes from the cream/coral pairing — deliberately warm and humanist where most AI brands use cool blue + slate. Type voice runs a slab-serif display (\"Copernicus\" / Tiempos Headline) for h1/h2 and a humanist sans for body. The signature Anthropic black-radial-spike mark anchors the wordmark.", "colors": [{"name": "Coral / Primary", "hex": "#cc785c", "group": "Brand & Accent", "token": "primary", "role": "The signature Anthropic warm coral. Used on every primary CTA background, on full-bleed coral callout cards, on the brand wordmark accent. The most-recognized Anthropic color outside of the spike-mark logo."}, {"name": "Coral Active", "hex": "#a9583e", "group": "Brand & Accent", "token": "primary-active", "role": "The press / hover-darker variant."}, {"name": "Coral Disabled", "hex": "#e6dfd8", "group": "Brand & Accent", "token": "primary-disabled", "role": "A desaturated cream-tinted disabled state."}, {"name": "Accent Teal", "hex": "#5db8a6", "group": "Brand & Accent", "token": "accent-teal", "role": "Used sparingly on secondary product surfaces (terminal status indicators, \"active connection\" dots in connectors page)."}, {"name": "Accent Amber", "hex": "#e8a55a", "group": "Brand & Accent", "token": "accent-amber", "role": "A small companion warm-tone used on category badges and inline highlights."}, {"name": "Canvas", "hex": "#faf9f5", "group": "Surface", "token": "canvas", "role": "The default page floor. Tinted cream — warm, deliberately not pure white."}, {"name": "Surface Soft", "hex": "#f5f0e8", "group": "Surface", "token": "surface-soft", "role": "Section dividers, very-soft band backgrounds."}, {"name": "Surface Card", "hex": "#efe9de", "group": "Surface", "token": "surface-card", "role": "Feature cards, content cards. One step darker than canvas."}, {"name": "Surface Cream Strong", "hex": "#e8e0d2", "group": "Surface", "token": "surface-cream-strong", "role": "A strongest-cream variant used on selected category tabs and emphasized section bands."}, {"name": "Surface Dark", "hex": "#181715", "group": "Surface", "token": "surface-dark", "role": "Code editor mockups, model showcase cards, footer. The dominant dark surface."}, {"name": "Surface Dark Elevated", "hex": "#252320", "group": "Surface", "token": "surface-dark-elevated", "role": "Elevated cards inside dark bands (settings panels in mockups)."}, {"name": "Surface Dark Soft", "hex": "#1f1e1b", "group": "Surface", "token": "surface-dark-soft", "role": "Slightly lighter dark, used for code block backgrounds inside larger dark cards."}, {"name": "Hairline", "hex": "#e6dfd8", "group": "Surface", "token": "hairline", "role": "The 1px border tone on cream surfaces. Same hex as `{colors.primary-disabled}` — borders feel like one elevation step rather than ink lines."}, {"name": "Hairline Soft", "hex": "#ebe6df", "group": "Surface", "token": "hairline-soft", "role": "Barely-visible divider used inside the same band."}, {"name": "Ink", "hex": "#141413", "group": "Text", "token": "ink", "role": "All headlines and primary text. Warm dark, slightly off-pure-black."}, {"name": "Body Strong", "hex": "#252523", "group": "Text", "token": "body-strong", "role": "Emphasized paragraphs, lead text."}, {"name": "Body", "hex": "#3d3d3a", "group": "Text", "token": "body", "role": "Default running-text color."}, {"name": "Muted", "hex": "#6c6a64", "group": "Text", "token": "muted", "role": "Sub-headings, breadcrumbs, footer-adjacent secondary text."}, {"name": "Muted Soft", "hex": "#8e8b82", "group": "Text", "token": "muted-soft", "role": "Captions, fine-print, copyrig