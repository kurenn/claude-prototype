{"slug": "cal", "name": "Cal.com", "category": "Productivity & SaaS", "summary": "Open-source scheduling. Clean neutral UI, developer-oriented simplicity", "description": "A clean, calendar-software-first interface anchored on white canvas with black primary CTAs and custom Cal Sans display typography. The system reads as friendly modern SaaS — generous whitespace, soft-rounded cards (~12px), product UI fragments shown directly inside cards, and a dark navy footer that visually closes long-scroll pages. Brand voltage comes from the Cal Sans display headline (a custom geometric face) and from product UI artifacts shown in-card rather than from accent colors.", "colors": [{"name": "Primary", "hex": "#111111", "group": "Brand & Accent", "token": "primary", "role": "The dominant action color. All primary CTAs, h1/h2 display type. Press state shifts to `{colors.primary-active}` (#242424)."}, {"name": "Brand Accent", "hex": "#3b82f6", "group": "Brand & Accent", "token": "brand-accent", "role": "Used sparely on inline links and on a small badge / \"Customer story\" highlight. Cal.com is a near-monochrome brand — the blue appears rarely."}, {"name": "Badge Pastels", "hex": "#fb923c", "group": "Brand & Accent", "token": "badge-orange", "role": "A small pastel set for category badges and avatar fills: `{colors.badge-orange}` (#fb923c), `{colors.badge-pink}` (#ec4899), `{colors.badge-violet}` (#8b5cf6), `{colors.badge-emerald}` (#34d399). These appear on tag pills and small accent moments inside product UI fragments — never on hero CTAs."}, {"name": "Canvas", "hex": "#ffffff", "group": "Surface", "token": "canvas", "role": "The default page floor."}, {"name": "Surface Soft", "hex": "#f8f9fa", "group": "Surface", "token": "surface-soft", "role": "Nav-pill-group background, very-soft section dividers."}, {"name": "Surface Card", "hex": "#f5f5f5", "group": "Surface", "token": "surface-card", "role": "Feature cards, testimonial cards, badge pills, default avatar fills."}, {"name": "Surface Strong", "hex": "#e5e7eb", "group": "Surface", "token": "surface-strong", "role": "Hairline border alternative; disabled button background."}, {"name": "Surface Dark", "hex": "#101010", "group": "Surface", "token": "surface-dark", "role": "The footer background — the only dark surface on every page. Also used for the featured pricing tier card."}, {"name": "Surface Dark Elevated", "hex": "#1a1a1a", "group": "Surface", "token": "surface-dark-elevated", "role": "Used for nested cards inside the dark footer or featured pricing card."}, {"name": "Hairline", "hex": "#e5e7eb", "group": "Surface", "token": "hairline", "role": "The 1px border tone on light surfaces. Used on input borders, table dividers, content card outlines (sometimes)."}, {"name": "Hairline Soft", "hex": "#f3f4f6", "group": "Surface", "token": "hairline-soft", "role": "A barely-visible divider used between sections that share the white canvas."}, {"name": "Ink", "hex": "#111111", "group": "Text", "token": "ink", "role": "All headlines and primary text."}, {"name": "Body", "hex": "#374151", "group": "Text", "token": "body", "role": "Default running-text color."}, {"name": "Muted", "hex": "#6b7280", "group": "Text", "token": "muted", "role": "Secondary text — sub-headings, breadcrumbs, footer body."}, {"name": "Muted Soft", "hex": "#898989", "group": "Text", "token": "muted-soft", "role": "Tertiary text — captions, fine-print, copyright lines."}, {"name": "On Primary / On Dark", "hex": "#ffffff", "group": "Text", "token": "on-primary", "role": "Text on primary buttons and dark footer."}, {"name": "On Dark Soft", "hex": "#a1a1aa", "group": "Text", "token": "on-dark-soft", "role": "Footer body text — slightly muted white for the link rows."}, {"name": "Success", "hex": "#10b981", "group": "Semantic", "token": "success", "role": "Confirmation states, success badges in product UI."}, {"name": "Warning", "hex": "#f59e0b", "group": "Semantic", "token": "warning", "role": "Warning callouts."}, {"name": 