{"slug": "sap", "name": "SAP", "category": "Productivity & SaaS", "summary": "Enterprise business software. White canvas, flat blue bands, application-frame chrome", "description": "An analysis of SAP's design language — an enterprise system that keeps almost everything on white and spends its structure on two greys and one blue. The chrome is deliberately quiet, a 60px light-grey bar over a product tab rail, so the page reads as an application frame rather than a marketing surface. Depth comes from broad flat bands rather than shadow, corners stay at 8px on controls and 12px on media, and the brand's own variable typeface carries a 350-to-700 weight range that lets a 15px list item and a 15px nav link read as different classes of text at the same size.", "colors": [{"name": "SAP Blue", "hex": "#0057d2", "group": "Brand & Accent", "token": "primary", "role": "the acting colour. Every filled button, every inline text link, and the active product tab."}, {"name": "Deep Blue", "hex": "#0040b0", "group": "Brand & Accent", "token": "primary-deep", "role": "the solid hero band on interior pages, and the label colour inside an outline button placed on white."}, {"name": "On Primary", "hex": "#ffffff", "group": "Brand & Accent", "token": "on-primary", "role": "the label on every blue fill and all type inside the hero band."}, {"name": "Navy", "hex": "#022879", "group": "Brand & Accent", "token": "navy", "role": "the anchor of the home page's hero gradient, the one atmospheric surface in the system."}, {"name": "Sky", "hex": "#6bc0ff", "group": "Brand & Accent", "token": "sky", "role": "a light blue panel used inside the services layout."}, {"name": "Canvas", "hex": "#ffffff", "group": "Surface", "token": "canvas", "role": "the working ground. Content panes, cards and most sections sit on it unchanged."}, {"name": "Chrome", "hex": "#f5f6f7", "group": "Surface", "token": "chrome", "role": "the global navigation bar, and the neutral band used to set a section apart."}, {"name": "Band", "hex": "#eaecee", "group": "Surface", "token": "band", "role": "the footer ground, and the largest single non-white surface on the home page."}, {"name": "Band Blue", "hex": "#ebf8ff", "group": "Surface", "token": "band-blue", "role": "a pale blue strip used to lift a section out of the white run."}, {"name": "Band Lavender", "hex": "#f7f4ff", "group": "Surface", "token": "band-lavender", "role": "a softer wash serving the same role on product pages, with a curved upper edge rather than a square one."}, {"name": "Ink", "hex": "#000000", "group": "Text", "token": "ink", "role": "headings at every level. SAP sets its headlines in true black, not a softened near-black."}, {"name": "Ink Lead", "hex": "#3c3c3c", "group": "Text", "token": "ink-lead", "role": "the 28px lead paragraph that follows a display headline."}, {"name": "Ink Body", "hex": "#223548", "group": "Text", "token": "ink-body", "role": "body copy. A slate rather than a grey, which is what separates the paragraph tier from the lead tier."}, {"name": "Ink List", "hex": "#354a5f", "group": "Text", "token": "ink-list", "role": "list items, set one step lighter than body."}, {"name": "Ink Meta", "hex": "#475e75", "group": "Text", "token": "ink-meta", "role": "captions and footnotes, the quietest legible tier."}, {"name": "Ink Nav", "hex": "#545454", "group": "Text", "token": "ink-nav", "role": "navigation links, breadcrumbs and tab labels. The only text colour that is a neutral grey rather than a slate, which is how the chrome stays visually separate from the content."}, {"name": "Hairline", "hex": "#475e75", "group": "Semantic", "token": "hairline", "role": "the rule on an outline button. The same value as `{colors.ink-meta}`, used as a border rather than as type."}], "tokens": {"colors": {"primary": "#0057d2", "primary-deep": "#0040b0", "on-primary": "#ffffff", "navy": "#022879", "sky": "#6bc0ff", "canvas": "#ffffff", "chrome": "#f5f6f7", "band": "#eaecee", "band-blue": "#ebf8ff", "band-lavender": "