{"slug": "airtable", "name": "Airtable", "category": "Design & Creative Tools", "summary": "Spreadsheet-database hybrid. Colorful, friendly, structured data aesthetic", "description": "A sober, editorial workflow-software interface anchored on white canvas and dark-ink type, where brand voltage comes from full-bleed signature cards in coral, dark green, peach, and dark navy that punctuate long-scroll explainer pages. Primary actions use a near-black pill CTA; secondary actions sit in a white outlined button. Type runs Haas Grotesk in modest weights — never bold for its own sake.", "colors": [{"name": "Primary", "hex": "#181d26", "group": "Brand & Accent", "token": "primary", "role": "The dominant brand color. Used for the primary CTA background, h1/h2 display type, and the `{component.surface-dark}` band. Not \"blue, then black\" — black IS the primary throughout the marketing system."}, {"name": "Primary Active", "hex": "#0d1218", "group": "Brand & Accent", "token": "primary-active", "role": "The press state on primary buttons."}, {"name": "Canvas", "hex": "#ffffff", "group": "Surface", "token": "canvas", "role": "The default page surface; the floor of every editorial body."}, {"name": "Surface Soft", "hex": "#f8fafc", "group": "Surface", "token": "surface-soft", "role": "Tabbed feature cards and the featured pricing tier."}, {"name": "Surface Strong", "hex": "#e0e2e6", "group": "Surface", "token": "surface-strong", "role": "The light gray \"Start building with Airtable\" CTA banner near the footer."}, {"name": "Surface Dark", "hex": "#181d26", "group": "Surface", "token": "surface-dark", "role": "The dark navy CTA cards used mid-page (for example \"The path to 10× every person in your organization\")."}, {"name": "Surface Dark Elevated", "hex": "#1d1f25", "group": "Surface", "token": "surface-dark-elevated", "role": "The articles-page hero base behind the rainbow-stripe overlay."}, {"name": "Hairline", "hex": "#dddddd", "group": "Surface", "token": "hairline", "role": "The 1px border tone for input outlines, table dividers, secondary-button outlines."}, {"name": "Ink", "hex": "#181d26", "group": "Text", "token": "ink", "role": "The strongest text — h1/h2 display type and primary button text-on-light. Same hex as `{colors.primary}` because they are the same role expressed at type and button layers."}, {"name": "Body", "hex": "#333840", "group": "Text", "token": "body", "role": "The default running-text color."}, {"name": "Muted", "hex": "#41454d", "group": "Text", "token": "muted", "role": "Footer links, breadcrumbs, captions."}, {"name": "Border Strong", "hex": "#9297a0", "group": "Text", "token": "border-strong", "role": "The 1px outline color on disabled secondary buttons."}, {"name": "On Primary / On Dark", "hex": "#ffffff", "group": "Text", "token": "on-primary", "role": "The text color on primary buttons and dark surfaces."}, {"name": "Coral", "hex": "#aa2d00", "group": "Signature Card Surfaces", "token": "signature-coral", "role": "The largest signature card on the homepage (\"Production apps in prototype speed\"). Full-bleed dark coral with white type."}, {"name": "Forest", "hex": "#0a2e0e", "group": "Signature Card Surfaces", "token": "signature-forest", "role": "A deep-green signature card used in the homepage demo-grid cluster."}, {"name": "Cream", "hex": "#f5e9d4", "group": "Signature Card Surfaces", "token": "signature-cream", "role": "The cream callout band (\"The path to 10× every person in your organization\") — a soft beige surface holding dark type and product UI fragments."}, {"name": "Peach", "hex": "#fcab79", "group": "Signature Card Surfaces", "token": "signature-peach", "role": "Demo-card surfaces that carry small product UI fragments inside the multi-card grid sections."}, {"name": "Link", "hex": "#1b61c9", "group": "Semantic", "token": "link", "role": "Inline body links and anchor text. Darker on press to `{colors.link-active}` (#1a3866). Despite the `--theme_button-background-primary` CSS-variable name, this color is **not** the primary button color — it is the link color."}, {"name": "Info", "hex": "#254fad", "group": "Semantic", "token": "info", "role": "Inline info badges and focused-input outline."}, {"name": "Success", "hex": "#006400", "group": "Semantic", "token": "success", "role": "Confirmation states."}], "tokens": {"colors": {"primary": "#181d26", "primary-active": "#0d1218", "ink": "#181d26", "body": "#333840", "muted": "#41454d", "hairline": "#dddddd", "border-strong": "#9297a0", "canvas": "#ffffff", "surface-soft": "#f8fafc", "surface-strong": "#e0e2e6", "surface-dark": "#181d26", "surface-dark-elevated": "#1d1f25", "signature-coral": "#aa2d00", "signature-forest": "#0a2e0e", "signature-cream": "#f5e9d4", "signature-peach": "#fcab79", "signature-mint": "#a8d8c4", "signature-yellow": "#f4d35e", "signature-mustard": "#d9a441", "on-primary": "#ffffff", "on-dark": "#ffffff", "link": "#1b61c9", "link-active": "#1a3866", "info": "#254fad", "info-border": "#458fff", "success": "#006400", "success-border": "#39bf45", "pricing-ink": "#1d1f25"}, "rounded": {"xs": "2px", "sm": "6px", "md": "10px", "lg": "12px", "pill": "9999px", "full": "9999px"}, "spacing": {"xxs": "4px", "xs": "8px", "sm": "12px", "md": "16px", "lg": "24px", "xl": "32px", "xxl": "48px", "section": "96px"}}, "typography": {"display-xl": {"fontFamily": "Haas Groot Disp, Haas, sans-serif", "fontSize": "48px", "fontWeight": "500", "lineHeight": "1.1", "letterSpacing": "0", "preview": null}, "display-lg": {"fontFamily": "Haas Groot Disp, Haas, sans-serif", "fontSize": "40px", "fontWeight": "400", "lineHeight": "1.2", "letterSpacing": "0", "preview": null}, "display-md": {"fontFamily": "Haas Groot Disp, Haas, sans-serif", "fontSize": "32px", "fontWeight": "400", "lineHeight": "1.2", "letterSpacing": "0", "preview": null}, "title-lg": {"fontFamily": "Haas, sans-serif", "fontSize": "24px", "fontWeight": "400", "lineHeight": "1.35", "letterSpacing": "0.12px", "preview": null}, "title-md": {"fontFam