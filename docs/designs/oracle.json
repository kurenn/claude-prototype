{"slug": "oracle", "name": "Oracle", "category": "Backend, Database & DevOps", "summary": "Enterprise cloud and database software. Warm neutral ladder, charcoal-only actions, red saved for the wordmark", "description": "An analysis of Oracle's design language — an enterprise system built on a warm neutral ladder rather than a colour palette. Six numbered greys carry almost every surface, a single dark charcoal carries every action, and the famous red is held back for the wordmark alone. Two display registers coexist, being a very light sans on the corporate index and a Georgia serif across the product pages, and the only chromatic moments are a thin gold rule under a headline and the occasional full-width band of teal or forest green.", "colors": [{"name": "Oracle Red", "hex": "#c74634", "group": "Brand & Accent", "token": "brand-mark", "role": "the wordmark, and only the wordmark. It appears in the masthead at the top of every page and is not used for any button, link, border, band or highlight. Elsewhere on the page red shows up only inside photography and inside logos printed on product hardware."}, {"name": "Action Charcoal", "hex": "#312d2a", "group": "Brand & Accent", "token": "primary", "role": "the fill behind every primary action on the site. Warm rather than neutral, and a clear step lighter than `{colors.ink}` so a filled button reads as an object rather than as a block of text."}, {"name": "Action Charcoal Pressed", "hex": "#47423e", "group": "Brand & Accent", "token": "primary-pressed", "role": "the active state of that button."}, {"name": "On Primary", "hex": "#ffffff", "group": "Brand & Accent", "token": "on-primary", "role": "the label on a filled action, and the text colour on every inverted surface."}, {"name": "Gold Rule", "hex": "#f0cc71", "group": "Brand & Accent", "token": "accent-gold", "role": "a 40 × 4px bar sitting under the hero headline on every product page. The system's one piece of ornament."}, {"name": "Gold Tab", "hex": "#f7e0a1", "group": "Brand & Accent", "token": "accent-gold-soft", "role": "a paler gold, 5px tall, marking the selected item in the dark product sub-navigation."}, {"name": "Canvas", "hex": "#ffffff", "group": "Surface", "token": "canvas", "role": "the masthead, the footer, content cards, and the brightest section bands."}, {"name": "Canvas Soft", "hex": "#fbf9f8", "group": "Surface", "token": "canvas-soft", "role": "the most common product-page section fill. One barely-perceptible step off white."}, {"name": "Canvas Tint", "hex": "#f5f4f2", "group": "Surface", "token": "canvas-tint", "role": "the next step, used for supporting sections and the contact hero."}, {"name": "Canvas Warm", "hex": "#f1efed", "group": "Surface", "token": "canvas-warm", "role": "the warmest and most-used tint, carrying the corporate index page almost end to end and every product hero band."}, {"name": "Hairline", "hex": "#e4e1dd", "group": "Surface", "token": "hairline", "role": "the tile and disabled-control border, and the last neutral rung before the dark end."}, {"name": "Divider", "hex": "#e9e7e4", "group": "Surface", "token": "divider", "role": "the 2px vertical rule that separates the contact page's channel columns."}, {"name": "Field Border", "hex": "#d4cfca", "group": "Surface", "token": "field-border", "role": "the 1px border around the masthead search field, one clear step darker than `{colors.hairline}` so an input reads as interactive against a card that merely reads as a container."}, {"name": "Ink Deep", "hex": "#211e1c", "group": "Surface", "token": "ink-deep", "role": "the dark end of the ladder, used as a full-width band behind the product sub-navigation."}, {"name": "Ink", "hex": "#161513", "group": "Text", "token": "ink", "role": "every heading and every line of body copy. A warm near-black, never pure black, which keeps the very light 300-weight display sizes from looking harsh."}, {"name": "Link", "hex": "#006b8f", "group": "Text", "token": "link", "role": "inline links in body copy and channel columns. A deep teal-blue, set without an underline, at the same size and weight as the text around it — the colour alone carries the affordance."}, {"name": "Focus", "hex": "#227e9e", "group": "Semantic", "token": "focus", "role": "the focus indicator, declared once and applied identically on light and dark surfaces, so a keyboard user sees the same ring everywhere."}, {"name": "Error", "hex": "#d63b25", "group": "Semantic", "token": "error", "role": "validation messaging and error field text."}, {"name": "Disabled Ink", "hex": "#aea8a2", "group": "Semantic", "token": "disabled-ink", "role": "the label on a disabled control, paired with a `{colors.canvas-soft}` fill and a `{colors.hairline}` border."}, {"name": "Band Teal", "hex": "#d6e5e5", "group": "Band Colours", "token": "band-teal", "role": "a pale teal strip, roughly 120 to 160px tall, used to break a run of neutral sections."}, {"name": "Band Forest", "hex": "#33553c", "group": "Band Colours", "token": "band-forest", "role": "a deep green band carrying white text and a multi-column link list, around 390px tall."}], "tokens": {"colors": {"primary": "#312d2a", "primary-pressed": "#47423e", "on-primary": "#ffffff", "brand-mark": "#c74634", "ink": "#161513", "ink-deep": "#211e1c", "canvas": "#ffffff", "canvas-soft": "#fbf9f8", "canvas-tint": "#f5f4f2", "canvas-warm": "#f1efed", "hairline": "#e4e1dd", "divider": "#e9e7e4", "field-border": "#d4cfca", "link": "#006b8f", "accent-gold": "#f0cc71", "accent-gold-soft": "#f7e0a1", "band-teal": "#d6e5e5", "band-forest": "#33553c", "focus": "#227e9e", "error": "#d63b25", "disabled-ink": "#aea8a2"}, "rounded": {"none": "0px", "xs": "4px", "sm": "6px", "md": "8px", "lg": "12px", "xl": "15px", "full": "9999px"}, "spacing": {"xs": "10px", "sm": "12px", "md": "16px", "lg": "18px", "xl": "20px", "xxl": "24px", "xxxl": "32px", "section": "48px", "gutter": "72px"}}, "typography": {"display-serif-xl": {"fontFamily": "Georgia", "fontSize": "56px", "fontWeight": "400", "lineHeight": "67.2px", "letterSpacing": "0", "preview": "Georgia"}, "display-serif-lg": {"fontFamily": "Georgia", "fontSize": "40px", "fontWeight": "400", "lineHeight": "48px", "letterSpacing": "0", "preview": "Georgia"}, "display-serif-md": {"fontFamily": "Georgia", "fontSize": "36px", "fontWeight": "400", "lineHeight": "43.2px", "letterSpacing": "0", "preview": "Georgia"}, "display-sans-lg": {"fontFamily": "Oracle Sans", "fontSize": "40px", "fontWeight": "300", "lineHeight": "52px", "letterSpacing": "0", "preview": "Inter"}, "display-sans-md": {"fontFamily": "Oracle Sans", "fontSize": "32px", "fontWeight": "300", "lineHeight": "44px", "letterSpacing": "0", "preview": "Inter"}, "heading-xl": {"fontFamily": "Oracle Sans", "fontSize": "28px", "fontWeight": "800", "lineHeight": "33.6px", "letterSpacing": "0", "preview": "Inter"}, "heading-lg": {"fontFamily": "Oracle Sans", "fontSize": "24px", "fontWeight": "800", "lineHeight": "28.8px", "letterSpacing": "0", "preview": "Inter"}, "heading-md": {"fontFamily": "Oracle Sans", "fontSize": "20px", "fontWeight": "800", "lineHeight": "24px", "letterSpacing": "0", "preview": "Inter"}, "heading-sm": {"fontFamily": "Oracle Sans", "fontSize": "18px", "fontWeight": "800", "lineHeight": "21.6px", "letterSpacing": "0", "preview": "Inter"}, "heading-card": {"fontFamily": "Oracle Sans", "fontSize": "24px", "fontWeight": "600", "lineHeight": "32px", "letterSpacing": "0", "preview": "Inter"}, "lead": {"fontFamily": "Oracle Sans", "fontSize": "24px", "fontWeight": "400", "lineHeight": "33.6px", "letterSpacing": "0", "preview": "Inter"}, "body": {"fontFamily": "Oracle Sans", "fontSize": "16px", "fontWeight": "400", "lineHeight": "22.4px", "letterSpacing": "0", "preview": "Inter"}, "body-loose": {"fontFamily": "Oracle Sans", "fontSize": "16px", "fontWeight": "350", "lineHeight": "24px", "letterSpacing": "0", "preview": "Inter"}, "body-strong": {"fontFamily": "Oracle Sans", "fontSize": "16px", "fontWeight": "700", "lineHeight": "22.4px", "letterSpacing": "0", "preview": "Inter"}, "label": {"fontFamily": "Oracle Sans", "fontSize": "14px", "fontWeight": "500", "lineHeight": "16.8px", "letterSpacing": "0", "preview": "Inter"}, "label-strong": {"fontFamily": "Oracle Sans", "fontSize": "14px", "fontWeight": "600", "lineHeight": "20px", "letterSpacing": "0", "preview": "Inter"}, "caption": {"fontFamily": "Oracle Sans", "fontSize": "12px", "fontWeight": "400", "lineHeight": "20px", "letterSpacing": "0", "preview": "Inter"}}, "substitutes": {"Oracle Sans": "Inter"}, "substitutesNote": "**Oracle Sans** is a proprietary variable face. The closest open substitute is **Inter**, which shares the humanist skeleton and open apertures and offers a full variable weight axis including the 350 and 800 stops this system depends on; **Source Sans 3** is a warmer alternative but tops out lower and needs the 800 roles dropped to 700. **Georgia** ships with virtually every operating system and needs no substitution; if a webfont is required, **Gelasio** is metric-compatible with it. **Consolas** substitutes cleanly with **JetBrains Mono**. Keep the 1.2 heading line-height, the 1.4 body line-height, and zero tracking on any substitute.", "components": {"masthead": {"backgroundColor": "#ffffff", "textColor": "#161513", "typography": {"fontFamily": "Oracle Sans", "fontSize": "16px", "fontWeight": "400", "lineHeight": "22.4px", "letterSpacing": "0", "preview": "Inter"}, "rounded": "0px", "height": "85px"}, "logo-wordmark": {"backgroundColor": "#ffffff", "textColor": "#c74634", "typography": {"fontFamily": "Oracle Sans", "fontSize": "24px", "fontWeight": "800", "lineHeight": "28.8px", "letterSpacing": "0", "preview": "Inter"}, "rounded": "0px"}, "text-input": {"backgroundColor": "#ffffff", "textColor": "#161513", "typography": {"fontFamily": "Oracle Sans", "fontSize": "16px", "fontWeight": "400", "lineHeight": "22.4px", "letterSpacing": "0", "preview": "Inter"}, "borderColor": "#d4cfca", "rounded": "6px", "padding": "12px 18px"}, "product-subnav": {"backgroundColor": "#211e1c", "textColor": "#ffffff", "typography": {"fontFamily": "Oracle Sans", "fontSize": "16px", "fontWeight": "400", "lineHeight": "22.4px", "letterSpacing": "0", "preview": "Inter"}, "rounded": "0px", "height": "64px"}, "product-subnav-light": {"backgroundColor": "#ffffff", "textColor": "#161513", "typography": {"fontFamily": "Oracle Sans", "fontSize": "16px", "fontWeight": "400", "lineHeight": "22.4px", "letterSpacing": "0", "preview": "Inter"}, "rounded": "0px", "height": "64px"}, "subnav-active-bar": {"backgroundColor": "#f7e0a1", "rounded": "0px", "height": "5px", "width": "67px"}, "button-primary": {"backgroundColor": "#312d2a", "textColor": "#ffffff", "typography": {"fontFamily": "Oracle Sans", "fontSize": "14px", "fontWeight": "500", "lineHeight": "16.8px", "letterSpacing": "0", "preview": "Inter"}, "rounded": "4px", "padding": "10px 16px"}, "button-primary-pressed": {"backgroundColor": "#47423e", "textColor": "#ffffff", "typography": {"fontFamily": "Oracle Sans", "fontSize": "14px", "fontWeight": "500", "lineHeight": "16.8px", "letterSpacing": "0", "preview": "Inter"}, "rounded": "4px", "padding": "10px 16px"}, "button-primary-disabled": {"backgroundColor": "#fbf9f8", "textColor": "#aea8a2", "typography": {"fontFamily": "Oracle Sans", "fontSize": "14px", "fontWeight": "500", "lineHeight": "16.8px", "letterSpacing": "0", "preview": "Inter"}, "borderColor": "#e4e1dd", "rounded": "4px", "padding": "10px 16px"}, "button-secondary": {"textColor": "#161513", "typography": {"fontFamily": "Oracle Sans", "fontSize": "14px", "fontWeight": "500", "lineHeight": "16.8px", "letterSpacing": "0", "preview": "Inter"}, "borderColor": "#161513", "rounded": "4px", "padding": "10px 16px"}, "button-tertiary": {"textColor": "#161513", "typography": {"fontFamily": "Oracle Sans", "fontSize": "14px", "fontWeight": "500", "lineHeight": "16.8px", "letterSpacing": "0", "preview": "Inter"}, "rounded": "4px", "padding": "10px 16px"}, "button-primary-inverse": {"backgroundColor": "#ffffff", "textColor": "#161513", "typography": {"fontFamily": "Oracle Sans", "fontSize": "14px", "fontWeight": "500", "lineHeight": "16.8px", "letterSpacing": "0", "preview": "Inter"}, "rounded": "4px", "padding": "10px 16px"}, "button-secondary-inverse": {"textColor": "#ffffff", "typography": {"fontFamily": "Oracle Sans", "fontSize": "14px", "fontWeight": "500", "lineHeight": "16.8px", "letterSpacing": "0", "preview": "Inter"}, "borderColor": "#ffffff", "rounded": "4px", "padding": "10px 16px"}, "hero-band": {"backgroundColor": "#f1efed", "textColor": "#161513", "typography": {"fontFamily": "Georgia", "fontSize": "36px", "fontWeight": "400", "lineHeight": "43.2px", "letterSpacing": "0", "preview": "Georgia"}, "rounded": "0px", "padding": "48px"}, "hero-eyebrow-rule": {"backgroundColor": "#f0cc71", "rounded": "0px", "width": "40px", "height": "4px"}, "section-band-white": {"backgroundColor": "#ffffff", "textColor": "#161513", "typography": {"fontFamily": "Oracle Sans", "fontSize": "16px", "fontWeight": "400", "lineHeight": "22.4px", "letterSpacing": "0", "preview": "Inter"}, "rounded": "0px", "padding": "48px"}, "section-band-soft": {"backgroundColor": "#fbf9f8", "textColor": "#161513", "typography": {"fontFamily": "Oracle Sans", "fontSize": "16px", "fontWeight": "400", "lineHeight": "22.4px", "letterSpacing": "0", "preview": "Inter"}, "rounded": "0px", "padding": "48px"}, "section-band-tint": {"backgroundColor": "#f5f4f2", "textColor": "#161513", "typography": {"fontFamily": "Oracle Sans", "fontSize": "16px", "fontWeight": "400", "lineHeight": "22.4px", "letterSpacing": "0", "preview": "Inter"}, "rounded": "0px", "padding": "48px"}, "section-band-warm": {"backgroundColor": "#f1efed", "textColor": "#161513", "typography": {"fontFamily": "Oracle Sans", "fontSize": "16px", "fontWeight": "400", "lineHeight": "22.4px", "letterSpacing": "0", "preview": "Inter"}, "rounded": "0px", "padding": "48px"}, "section-band-teal": {"backgroundColor": "#d6e5e5", "textColor": "#161513", "typography": {"fontFamily": "Oracle Sans", "fontSize": "16px", "fontWeight": "400", "lineHeight": "22.4px", "letterSpacing": "0", "preview": "Inter"}, "rounded": "0px", "padding": "48px"}, "section-band-forest": {"backgroundColor": "#33553c", "textColor": "#ffffff", "typography": {"fontFamily": "Oracle Sans", "fontSize": "16px", "fontWeight": "400", "lineHeight": "22.4px", "letterSpacing": "0", "preview": "Inter"}, "rounded": "0px", "padding": "48px"}, "content-card": {"backgroundColor": "#ffffff", "textColor": "#161513", "typography": {"fontFamily": "Oracle Sans", "fontSize": "16px", "fontWeight": "350", "lineHeight": "24px", "letterSpacing": "0", "preview": "Inter"}, "rounded": "15px", "padding": "32px"}, "stat-panel": {"backgroundColor": "#f1efed", "textColor": "#161513", "typography": {"fontFamily": "Oracle Sans", "fontSize": "16px", "fontWeight": "350", "lineHeight": "24px", "letterSpacing": "0", "preview": "Inter"}, "rounded": "15px", "padding": "20px"}, "product-card": {"backgroundColor": "#ffffff", "textColor": "#161513", "typography": {"fontFamily": "Oracle Sans", "fontSize": "16px", "fontWeight": "400", "lineHeight": "22.4px", "letterSpacing": "0", "preview": "Inter"}, "rounded": "8px", "padding": "24px"}, "product-card-warm": {"backgroundColor": "#f1efed", "textColor": "#161513", "typography": {"fontFamily": "Oracle Sans", "fontSize": "16px", "fontWeight": "400", "lineHeight": "22.4px", "letterSpacing": "0", "preview": "Inter"}, "rounded": "8px", "padding": "24px"}, "nav-tile": {"backgroundColor": "#ffffff", "textColor": "#161513", "typography": {"fontFamily": "Oracle Sans", "fontSize": "14px", "fontWeight": "600", "lineHeight": "20px", "letterSpacing": "0", "preview": "Inter"}, "borderColor": "#e4e1dd", "rounded": "12px", "padding": "16px"}, "media-frame": {"backgroundColor": "#ffffff", "rounded": "8px"}, "play-button-circular": {"backgroundColor": "#161513", "textColor": "#ffffff", "rounded": "9999px", "size": "40px"}, "channel-column": {"backgroundColor": "#ffffff", "textColor": "#161513", "typography": {"fontFamily": "Oracle Sans", "fontSize": "24px", "fontWeight": "800", "lineHeight": "28.8px", "letterSpacing": "0", "preview": "Inter"}, "borderColor": "#e9e7e4", "rounded": "0px", "padding": "24px"}, "link-inline": {"textColor": "#006b8f", "typography": {"fontFamily": "Oracle Sans", "fontSize": "16px", "fontWeight": "400", "lineHeight": "22.4px", "letterSpacing": "0", "preview": "Inter"}, "rounded": "0px"}, "footer": {"backgroundColor": "#ffffff", "textColor": "#161513", "typography": {"fontFamily": "Oracle Sans", "fontSize": "12px", "fontWeight": "400", "lineHeight": "20px", "letterSpacing": "0", "preview": "Inter"}, "rounded": "0px", "height": "105px"}, "footer-link": {"textColor": "#161513", "typography": {"fontFamily": "Oracle Sans", "fontSize": "12px", "fontWeight": "400", "lineHeight": "20px", "letterSpacing": "0", "preview": "Inter"}, "rounded": "0px"}, "ex-pricing-tier": {"description": "Default pricing tier card. Product-card chrome with a hairline border, since the system separates same-rung surfaces with a rule rather than a shadow.", "backgroundColor": "#ffffff", "textColor": "#161513", "borderColor": "#e4e1dd", "rounded": "8px", "padding": "24px"}, "ex-pricing-tier-featured": {"description": "Featured tier — polarity-flipped to the action charcoal with white text, the same inversion the dark bands perform.", "backgroundColor": "#312d2a", "textColor": "#ffffff", "rounded": "8px", "padding": "24px"}, "ex-product-selector": {"description": "What's-included summary card, one rung up the neutral ladder. Rows borrow the navigation-tile chrome.", "backgroundColor": "#fbf9f8", "textColor": "#161513", "rounded": "8px", "padding": "24px"}, "ex-cart-drawer": {"description": "Subscription summary. Line items are separated by the same warm rule the contact page uses between columns.", "backgroundColor": "#ffffff", "textColor": "#161513", "rounded": "8px", "padding": "24px", "item-divider": "#e9e7e4"}, "ex-app-shell-row": {"description": "Sidebar nav row at the product-card radius. Active state is marked by the action charcoal, the system's only emphasis fill.", "backgroundColor": "#ffffff", "textColor": "#161513", "typography": {"fontFamily": "Oracle Sans", "fontSize": "16px", "fontWeight": "400", "lineHeight": "22.4px", "letterSpacing": "0", "preview": "Inter"}, "activeIndicator": "#312d2a", "rounded": "8px", "padding": "12px 16px"}, "ex-data-table-cell": {"description": "Data-table header and body chrome. The header sits one rung up the ladder and rows are divided by a hairline.", "headerBackground": "#f5f4f2", "headerTypography": {"fontFamily": "Oracle Sans", "fontSize": "12px", "fontWeight": "400", "lineHeight": "20px", "letterSpacing": "0", "preview": "Inter"}, "bodyTypography": {"fontFamily": "Oracle Sans", "fontSize": "16px", "fontWeight": "400", "lineHeight": "22.4px", "letterSpacing": "0", "preview": "Inter"}, "cellPadding": "12px 16px", "rowBorder": "#e4e1dd"}, "ex-auth-form-card": {"description": "Sign-in card. Product-card chrome with the masthead search field's input treatment inside.", "backgroundColor": "#ffffff", "textColor": "#161513", "borderColor": "#e4e1dd", "rounded": "8px", "padding": "24px"}, "ex-modal-card": {"description": "Modal dialog surface — product-card chrome with a hairline border and no shadow, because the system has none.", "backgroundColor": "#ffffff", "textColor": "#161513", "borderColor": "#e4e1dd", "rounded": "8px", "padding": "24px"}, "ex-empty-state-card": {"description": "Empty-state frame one rung up the ladder, padded to the section rhythm.", "backgroundColor": "#fbf9f8", "textColor": "#161513", "rounded": "8px", "padding": "48px", "captionTypography": {"fontFamily": "Oracle Sans", "fontSize": "16px", "fontWeight": "400", "lineHeight": "22.4px", "letterSpacing": "0", "preview": "Inter"}}, "ex-toast": {"description": "Toast notification — the product-card radius on a white surface, bounded by a hairline instead of an elevation.", "backgroundColor": "#ffffff", "textColor": "#161513", "borderColor": "#e4e1dd", "rounded": "8px", "padding": "12px 20px", "typography": {"fontFamily": "Oracle Sans", "fontSize": "16px", "fontWeight": "400", "lineHeight": "22.4px", "letterSpacing": "0", "preview": "Inter"}}}, "structured": true, "source": "https://github.com/VoltAgent/awesome-design-md/blob/3b60532/design-md/oracle/DESIGN.md"}