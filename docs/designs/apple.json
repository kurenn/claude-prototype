{"slug": "apple", "name": "Apple", "category": "Media & Consumer Tech", "summary": "Consumer electronics. Premium white space, SF Pro, cinematic imagery", "description": "A photography-first interface that turns marketing into a museum gallery. Edge-to-edge product tiles alternate light and dark canvases, framed by SF Pro Display headlines with negative letter-spacing and a single Action Blue (#0066cc) interactive color. UI chrome recedes so the product can speak — no decorative gradients, no shadows on chrome, only the one signature drop-shadow under product imagery resting on a surface.", "colors": [{"name": "Action Blue", "hex": "#0066cc", "group": "Brand & Accent", "token": "primary", "role": "The single brand-level interactive color. All text links, all blue pill CTAs (\"Learn more\", \"Buy\"), and the focus ring root. This is Apple's quiet but universal \"click me\" signal. Press state shifts to a slightly darker variant via the active scale transform rather than a hex change."}, {"name": "Focus Blue", "hex": "#0071e3", "group": "Brand & Accent", "token": "primary-focus", "role": "A marginally brighter sibling of Action Blue, reserved for the keyboard focus ring on buttons (`outline: 2px solid`)."}, {"name": "Sky Link Blue", "hex": "#2997ff", "group": "Brand & Accent", "token": "primary-on-dark", "role": "A brighter blue used on dark surfaces for in-copy links and inline callouts, where Action Blue would disappear against the tile background."}, {"name": "Pure White", "hex": "#ffffff", "group": "Surface", "token": "canvas", "role": "The dominant canvas. Content, utility cards, store tiles, configurator grids."}, {"name": "Parchment", "hex": "#f5f5f7", "group": "Surface", "token": "canvas-parchment", "role": "The signature Apple off-white. Used for alternating light tiles, footer region, and the default page canvas in store utility sections. Just different enough from white to create rhythm."}, {"name": "Pearl Button", "hex": "#fafafc", "group": "Surface", "token": "surface-pearl", "role": "A near-white used as the fill for secondary \"ghost\" buttons — lighter than the parchment canvas so the button still reads as a button against `{colors.canvas-parchment}`."}, {"name": "Near-Black Tile 1", "hex": "#272729", "group": "Surface", "token": "surface-tile-1", "role": "The primary dark-tile surface on the homepage product grid."}, {"name": "Near-Black Tile 2", "hex": "#2a2a2c", "group": "Surface", "token": "surface-tile-2", "role": "A micro-step lighter — used where a dark tile sits directly above or below Tile 1 to create the faintest separation."}, {"name": "Near-Black Tile 3", "hex": "#252527", "group": "Surface", "token": "surface-tile-3", "role": "A micro-step darker — used at the bottom of the stack and in embedded video/player frames."}, {"name": "Pure Black", "hex": "#000000", "group": "Surface", "token": "surface-black", "role": "Reserved for true void — video player backgrounds, edge-to-edge photographic overlays, the global nav bar background."}, {"name": "Translucent Chip Gray", "hex": "#d2d2d7", "group": "Surface", "token": "surface-chip-translucent", "role": "The base hex of the translucent gray chip used over photography for circular control buttons. In production, applied at ~64% alpha as `rgba(210, 210, 215, 0.64)`."}, {"name": "Near-Black Ink", "hex": "#1d1d1f", "group": "Text", "token": "ink", "role": "The voice of every headline, every body paragraph, and the dark utility button's fill. Chosen instead of pure black to keep the page feeling photographic rather than printed."}, {"name": "Body", "hex": "#1d1d1f", "group": "Text", "token": "body", "role": "Same hex as ink — Apple uses one near-black tone for all text on light surfaces."}, {"name": "Body On Dark", "hex": "#ffffff", "group": "Text", "token": "body-on-dark", "role": "All text on dark tiles and on the global nav bar."}, {"name": "Body Muted", "hex": "#cccccc", "group": "Text", "token": "body-muted", "role": "Secondary copy on dark tiles where pure white would be too loud."}, {"name": "Ink Muted 80", "hex": "#333333", "group": "Text", "token": "ink-muted-80", "role": "Body text on the white Pearl Button surface — slightly softer than pure black."}, {"name": "Ink Muted 48", "hex": "#7a7a7a", "group": "Text", "token": "ink-muted-48", "role": "Disabled button text and legal fine-print."}, {"name": "Divider Soft", "hex": "#f0f0f0", "group": "Hairlines & Borders", "token": "divider-soft", "role": "The \"border\" tone on secondary buttons — functions as a ring shadow rather than a hard line. In production, often applied as `rgba(0, 0, 0, 0.04)`."}, {"name": "Hairline", "hex": "#e0e0e0", "group": "Hairlines & Borders", "token": "hairline", "role": "The 1px hairline border on store utility cards and configurator chips."}], "tokens": {"colors": {"primary": "#0066cc", "primary-focus": "#0071e3", "primary-on-dark": "#2997ff", "ink": "#1d1d1f", "body": "#1d1d1f", "body-on-dark": "#ffffff", "body-muted": "#cccccc", "ink-muted-80": "#333333", "ink-muted-48": "#7a7a7a", "divider-soft": "#f0f0f0", "hairline": "#e0e0e0", "canvas": "#ffffff", "canvas-parchment": "#f5f5f7", "surface-pearl": "#fafafc", "surface-tile-1": "#272729", "surface-tile-2": "#2a2a2c", "surface-tile-3": "#252527", "surface-black": "#000000", "surface-chip-translucent": "#d2d2d7", "on-primary": "#ffffff", "on-dark": "#ffffff"}, "rounded": {"none": "0px", "xs": "5px", "sm": "8px", "md": "11px", "lg": "18px", "pill": "9999px", "full": "9999px"}, "spacing": {"xxs": "4px", "xs": "8px", "sm": "12px", "md": "17px", "lg": "24px", "xl": "32px", "xxl": "48px", "section": "80px"}}, "typography": {"hero-display": {"fontFamily": "SF Pro Display, system-ui, -apple-system, sans-serif", "fontSize": "56px", "fontWeight": "600", "lineHeight": "1.07", "letterSpacing": "-0.28px", "preview": null}, "display-lg": {"fontFamily": "SF Pro Display, system-ui, -apple-system, sans-serif", "fontSize": "40px", "fontWeight": "600", "lineHeight": "1.1", "letterSpacing": "0", "preview": null}, "display-md": {"fontFamily": "SF Pro Text, system-ui, -apple-system, sans-serif", "fontSize": "34px", "fontWeight": "600", "lineHeight": "1.47", "letterSpacing": "-0.374px", "preview": null}, "lead": {"fontFamily": "SF Pro Display, system-ui, -apple-system, sans-serif", "fontSize": "28px", "fontWeight": "400", "lineHeight": "1.14", "letterSpacing": "0.196px", "preview": null}, "lead-airy": {"fontFamily": "SF Pro Text, system-ui, -apple-system, sans-serif", "fontSize": "24px", "fontWeight": "300", "lineHeight": "1.5", "letterSpacing": "0", "preview": null}, "tagline": {"fontFamily": "SF Pro Display, system-ui, -apple-system, sans-serif", "fontSize": "21px", "fontWeight": "600", "lineHeight": "1.19", "letterSpacing": "0.231px", "preview": null}, "body-strong": {"fontFamily": "SF Pro Text, system-ui, -apple-system, sans-serif", "fontSize": "17px", "fontWeight": "600", "lineHeight": "1.24", "letterSpacing": "-0.374px", "preview": null}, "body": {"fontFamily": "SF Pro Text, system-ui, -apple-system, sans-serif", "fontSize": "17px", "fontWeight": "400", "lineHeight": "1.47", "letterSpacing": "-0.374px", "preview": null}, "dense-link": {"fontFamily": "SF Pro Text, system-ui, -apple-system, sans-serif", "fontSize": "17px", "fontWeight": "400", "lineHeight": "2.41", "letterSpacing": "0", "preview": null}, "caption": {"fontFamily": "SF Pro Text, system-ui, -apple-system, sans-serif", "fontSize": "14px", "fontWeight": "400", "lineHeight": "1.43", "letterSpacing": "-0.224px", "preview": null}, "caption-strong": {"fontFamily": "SF Pro Text, system-ui, -apple-system, sans-serif", "fontSize": "14px", "fontWeight": "600", "lineHeight": "1.29", "letterSpacing": "-0.224px", "preview": null}, "button-large": {"fontFamily": "SF Pro Text, system-ui, -apple-system, sans-serif", "fontSize": "18px", "fontWeight": "300", "lineHeight": "1.0", "letterSpacing": "0", "preview": null}, "button-utility": {"fontFamily": "SF Pro Text, system-ui, -apple-system, sans-serif", "fontSize": "14px", "fontWeight": "400", "lineHeight": "1.29", "letterSpacing": "-0.224px", "preview": null}, "fine-print": {"fontFamily": "SF Pro Text, system-ui, -apple-system, sans-serif", "fontSize": "12px", "fontWeight": "400", "lineHeight": "1.0", "letterSpacing": "-0.12px", "preview": null}, "micro-legal": {"fontFamily": "SF Pro Text, system-ui, -apple-system, sans-serif", "fontSize": "10px", "fontWeight": "400", "lineHeight": "1.3", "letterSpacing": "-0.08px", "preview": null}, "nav-link": {"fontFamily": "SF Pro Text, system-ui, -apple-system, sans-serif", "fontSize": "12px", "fontWeight": "400", "lineHeight": "1.0", "letterSpacing": "-0.12px", "preview": null}}, "substitutes": {}, "substitutesNote": "SF Pro is Apple's proprietary system font. When building off-system:\n\n- Use `system-ui, -apple-system, BlinkMacSystemFont` as the first stack entry — on macOS/iOS/Safari this resolves to the real SF Pro.\n- For non-Apple platforms, **Inter** (Google Fonts, variable) is the closest open-source equivalent. Inter at weight 600 with `font-feature-settings: \"ss03\"` approximates SF Pro's rounded \"a\" character.\n- Nudge `letter-spacing` down by `-0.01em` on display sizes to re-create the Apple tight feel; Inter's default tracking runs slightly wider than SF Pro.\n- For body text, tighten line-height by `0.03` (from 1.47 → 1.44) when substituting Inter — Inter's taller x-height needs less leading.", "components": {"button-primary": {"backgroundColor": "#0066cc", "textColor": "#ffffff", "typography": {"fontFamily": "SF Pro Text, system-ui, -apple-system, sans-serif", "fontSize": "17px", "fontWeight": "400", "lineHeight": "1.47", "letterSpacing": "-0.374px", "preview": null}, "rounded": "9999px", "padding": "11px 22px"}, "button-primary-focus": {"backgroundColor": "#0066cc", "textColor": "#ffffff", "rounded": "9999px"}, "button-primary-active": {"backgroundColor": "#0066cc", "textColor": "#ffffff", "rounded": "9999px"}, "button-secondary-pill": {"backgroundColor": "#ffffff", "textCo