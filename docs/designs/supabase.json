{"slug": "supabase", "name": "Supabase", "category": "Backend, Database & DevOps", "summary": "Open-source Firebase alternative. Dark emerald theme, code-first", "description": "An inspired interpretation of Supabaze's design language — an open-source database platform built on a clean white-and-near-black system with a single signature emerald-green CTA, a custom humanist sans display tier, and dense product UI mockups composited above the hero. The brand reads as quietly technical: minimal chrome, a near-monochrome palette, and the green primary acting as the only chromatic event on the page.", "colors": [{"name": "Emerald", "hex": "#3ecf8e", "group": "Brand & Accent", "token": "primary", "role": "The signature CTA color. Filled-button background, brand wordmark accent, dot indicator."}, {"name": "Emerald Deep", "hex": "#24b47e", "group": "Brand & Accent", "token": "primary-deep", "role": "Pressed-state lift of the primary."}, {"name": "Emerald Soft", "hex": "#4ade80", "group": "Brand & Accent", "token": "primary-soft", "role": "Lighter emerald used in chart accents and product UI."}, {"name": "Accent Purple", "hex": "#6b01c2", "group": "Brand & Accent", "token": "accent-purple", "role": "Rare accent used in integration logos and chart points; never a button."}, {"name": "Accent Violet", "hex": "#644fc1", "group": "Brand & Accent", "token": "accent-violet", "role": "Secondary accent in the same role as accent purple."}, {"name": "Accent Yellow", "hex": "#ffdb13", "group": "Brand & Accent", "token": "accent-yellow", "role": "Chart accent / status indicator only."}, {"name": "Canvas", "hex": "#ffffff", "group": "Surface", "token": "canvas", "role": "Default page background."}, {"name": "Canvas Soft", "hex": "#fafafa", "group": "Surface", "token": "canvas-soft", "role": "Barely-tinted off-white for alternating section bands."}, {"name": "Canvas Night", "hex": "#1c1c1c", "group": "Surface", "token": "canvas-night", "role": "Deep near-black used in code blocks, dashboa