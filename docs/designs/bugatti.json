{"slug": "bugatti", "name": "Bugatti", "category": "Automotive", "summary": "Luxury hypercar. Cinema-black canvas, monochrome austerity, monumental display type", "description": "An austere luxury-automotive interface that uses near-pure black canvas, white uppercase letterspaced display, and full-bleed automotive photography as the only voltage. The system runs three custom Bugatti typefaces — Bugatti Display, Bugatti Text Regular, and Bugatti Monospace — and combines them at modest weights with wide tracking to feel European-engineered, hyper-minimal, and quietly expensive. There is no accent color, no decorative element, no chrome — only photography, typography, and the brand wordmark.", "colors": [{"name": "Primary", "hex": "#ffffff", "group": "Brand & Accent", "token": "primary", "role": "The single brand color. White type and white CTA outlines on the black canvas."}, {"name": "Link", "hex": "#c3d9f3", "group": "Brand & Accent", "token": "link", "role": "The only non-monochrome color in the system — a desaturated ice-blue used on inline anchor links and rarely on focus states. Bugatti's brand discipline is so tight that this single token is essentially the entire chromatic vocabulary outside black-and-white."}, {"name": "Canvas", "hex": "#000000", "group": "Surface", "token": "canvas", "role": "The default page floor across every surface. Pure black."}, {"name": "Surface Soft", "hex": "#0d0d0d", "group": "Surface", "token": "surface-soft", "role": "A barely-different-from-black tone used for spec table rows and dense data sections."}, {"name": "Surface Card", "hex": "#141414", "group": "Surface", "token": "surface-card", "role": "Cards (career callout, newsroom article container, occasional content cards). Even card surfaces stay nearly-black — no contrast jump."}, {"name": "Surface Elevated", "hex": "#1f1f1f", "group": "Surface", "token": "surface-elevated", "role": "One step further from black, used for nested cards on rare dense pages."}, {"name": "Hairline", "hex": "#262626", "group": "Surface", "token": "hairline", "role": "The 1px divider tone. Visible but quiet. Used on table rows, between body sections, around card outlines."}, {"name": "Hairline Strong", "hex": "#3a3a3a", "group": "Surface", "token": "hairline-strong", "role": "A heavier divider used on the underside of input fields (input fields have no border — only an underline hairline)."}, {"name": "Ink / On Dark", "hex": "#ffffff", "group": "Text", "token": "on-dark", "role": "All headline and primary text on dark canvas."}, {"name": "Body", "hex": "#cccccc", "group": "Text", "token": "body", "role": "Default running-text color (slightly cooler than pure white). Used in body paragraphs."}, {"name": "Body Strong", "hex": "#e6e6e6", "group": "Text", "token": "body-strong", "role": "Emphasized body / lead paragraph."}, {"name": "Muted", "hex": "#999999", "group": "Text", "token": "muted", "role": "Footer links, dates, captions, secondary metadata. Dembrandt's frequency analysis confirms this as palette-2 (count 6, medium confidence)."}, {"name": "Muted Soft", "hex": "#666666", "group": "Text", "token": "muted-soft", "role": "A second-tier muted for very-secondary text (legal disclaimer, copyright line)."}, {"name": "Warning", "hex": "#d4a017", "group": "Semantic", "token": "warning", "role": "Reserved for technical-warning callouts (specifications, recall notices). Almost never appears on marketing surfaces."}, {"name": "Success", "hex": "#5fa657", "group": "Semantic", "token": "success", "role": "Order confirmation states (rare on marketing pages)."}], "tokens": {"colors": {"primary": "#ffffff", "ink": "#ffffff", "body": "#cccccc", "body-strong": "#e6e6e6", "muted": "#999999", "muted-soft": "#666666", "hairline": "#262626", "hairline-strong": "#3a3a3a", "canvas": "#000000", "surface-soft": "#0d0d0d", "surface-card": "#141414", "surface-elevated": "#1f1f1f", "on-primary": "#000000", "on-dark": "#ffffff", "on-photo": "#ffffff", "link": "#c3d9f3", "warning": "#