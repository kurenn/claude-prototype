{"slug": "binance", "name": "Binance", "category": "Fintech & Crypto", "summary": "Crypto exchange. Bold Binance Yellow on monochrome, trading-floor urgency", "description": "A confident financial-platform interface anchored on a deep near-black canvas, where Binance's iconic yellow (#FCD535) carries every primary CTA, brand accent, and value-claim moment. Type runs Binance's custom BinanceNova / BinancePlex stack at modest weights — the system trusts size and yellow voltage over bold weight. Marketing and product surfaces default to the dark theme; transactional surfaces (buy crypto, deposit, exchange) flip to a light theme that shares the same yellow CTAs and gray-blue hairlines. Trading green (up) and red (down) accents thread through both modes for price-direction signals.", "colors": [{"name": "Binance Yellow", "hex": "#fcd535", "group": "Brand & Accent", "token": "primary", "role": "The single brand color. Used for primary CTA backgrounds, the wordmark, brand-claim headlines (\"FUNDS ARE SAFU\"), trust badges (\"No.1 Trading Volume\"), large stat numbers in `{component.stat-callout-card}`, and inline links."}, {"name": "Binance Yellow Active", "hex": "#f0b90b", "group": "Brand & Accent", "token": "primary-active", "role": "The press / hover-darker variant. Slightly more saturated yellow."}, {"name": "Binance Yellow Disabled", "hex": "#3a3a1f", "group": "Brand & Accent", "token": "primary-disabled", "role": "A desaturated dark-yellow used on disabled CTAs over dark canvas."}, {"name": "Accent Turquoise", "hex": "#2dbdb6", "group": "Brand & Accent", "token": "accent-turquoise", "role": "A small secondary accent used very sparingly on Smart Money's \"Check Now\" CTA over dark surfaces. Treat as a single-product accent, not a system color."}, {"name": "Canvas Dark", "hex": "#0b0e11", "group": "Surface", "token": "canvas-dark", "role": "The primary page floor. Near-black with a slight warm tint — never pure black."}, {"name": "Surface Card Dark", "hex": "#1e2329", "group": "Surface", "token": "surface-card-dark", "role": "Cards, navigation dropdowns, secondary buttons over dark canvas, markets table."}, {"name": "Surface Elevated Dark", "hex": "#2b3139", "group": "Surface", "token": "surface-elevated-dark", "role": "One step lighter, used for nested cards, hovered nav items, and chart background panels."}, {"name": "Canvas Light", "hex": "#ffffff", "group": "Surface", "token": "canvas-light", "role": "The page floor on transactional pages (buy crypto, deposit forms, account dialogs)."}, {"name": "Surface Soft Light", "hex": "#fafafa", "group": "Surface", "token": "surface-soft-light", "role": "Footer surface and disabled states."}, {"name": "Surface Strong Light", "hex": "#f5f5f5", "group": "Surface", "token": "surface-strong-light", "role": "Form input backgrounds in muted contexts."}, {"name": "Hairline on Light", "hex": "#eaecef", "group": "Hairlines & Borders", "token": "hairline-on-light", "role": "The 1px border tone on light surfaces. Dembrandt's frequency analysis confirms this as the highest-count token (1022 occurrences) — Binance uses hairlines liberally."}, {"name": "Hairline on Dark", "hex": "#2b3139", "group": "Hairlines & Borders", "token": "hairline-on-dark", "role": "The 1px border tone on dark surfaces. Same hex as `{colors.surface-elevated-dark}` — borders feel like surface steps, not ink lines."}, {"name": "Border Strong", "hex": "#cdd1d6", "group": "Hairlines & Borders", "token": "border-strong", "role": "A heavier border tone used on disabled secondary buttons."}, {"name": "Ink", "hex": "#181a20", "group": "Text", "token": "ink", "role": "The strongest text on light surfaces. Display headlines on transactional pages."}, {"name": "Body on Dark", "hex": "#eaecef", "group": "Text", "token": "body", "role": "Default running-text on dark canvas — deliberately not pure white, slightly cooler."}, {"name": "Body on Light", "hex": "#181a20", "group": "Text", "token": "body-on-light", "role": "Same as ink — light-mode body text reuses the ink token."}, {"name": "Muted", "hex": "#707a8a", "group": "Text", "token": "muted", "role": "Footer links, breadcrumbs, captions, table column headers. Works on both light and dark canvas."}, {"name": "Muted Strong", "hex": "#929aa5", "group": "Text", "token": "muted-strong", "role": "A second-tier muted for emphasized labels."}, {"name": "On Primary", "hex": "#181a20", "group": "Text", "token": "on-primary", "role": "Black text on yellow primary CTAs."}, {"name": "On Dark", "hex": "#ffffff", "group": "Text", "token": "on-dark", "role": "Pure white for high-contrast headlines on dark canvas."}, {"name": "Trading Up", "hex": "#0ecb81", "group": "Trading Semantics", "token": "trading-up", "role": "Price-up green, used as text color in tables, charts, and inline ticker arrows. Never as a button background."}, {"name": "Trading Down", "hex": "#f6465d", "group": "Trading Semantics", "token": "trading-down", "role": "Price-down red. Same usage rules as trading-up."}, {"name": "Info", "hex": "#3b82f6", "group": "Info / Focus", "token": "info", "role": "Inline info badges and the focus-ring base. The Tailwind `--tw-ring-color` token surfaced by dembrandt — used on input focus."}], "tokens": {"colors": {"primary": "#fcd535", "primary-active": "#f0b90b", "primary-disabled": "#3a3a1f", "ink": "#181a20", "body": "#eaecef", "body-on-light": "#181a20", "muted": "#707a8a", "muted-strong": "#929aa5", "hairline-on-light": "#eaecef", "hairline-on-dark": "#2b3139", "border-strong": "#cdd1d6", "canvas-light": "#ffffff", "canvas-dark": "#0b0e11", "surface-card-dark": "#1e2329", "surface-elevated-dark": "#2b3139", "surface-soft-light": "#fafafa", "surface-strong-light": "#f5f5f5", "on-primary": "#181a20", "on-dark": "#ffffff", "trading-up": "#0ecb81", "trading-down": "#f6465d", "accent-turquoise": "#2dbdb6", "info": "#3b82f6", "info-ring": "#3b82f6"}, "rounded": {"xs": "2px", "sm": "4px", "md": "6px", "lg": "8px", "xl": "12px", "pill": "9999px", "full": "9999px