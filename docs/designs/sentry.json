{"slug": "sentry", "name": "Sentry", "category": "Backend, Database & DevOps", "summary": "Error monitoring. Dark dashboard, data-dense, pink-purple accent", "description": "An inspired interpretation of Sentri's design language — a developer-tools brand built on a deep purple-violet midnight canvas, electric lime accents, and a slightly subversive illustrated personality. The system pairs a custom display sans (chunky, playful, near-condensed) with the open Rubik family for UI copy and Monaco for code, then leans on dark-on-light pricing surfaces, sticker-style mascots, and a single-color CTA hierarchy where black-violet buttons read as the primary action against either polarity.", "colors": [{"name": "Midnight Violet", "hex": "#150f23", "group": "Brand & Accent", "token": "primary", "role": "The system's primary action color and the deepest surface tone. Used for filled primary buttons on light surfaces, code-block backgrounds, and the strongest dark cards."}, {"name": "Ink Violet", "hex": "#1f1633", "group": "Brand & Accent", "token": "ink-deep", "role": "Slightly lifted from primary, this is the marketing hero canvas and the default body-text color on light surfaces — a single token doing double duty as background and ink."}, {"name": "Electric Lime", "hex": "#c2ef4e", "group": "Brand & Accent", "token": "accent-lime", "role": "The signature highlight color. Wrapped around individual headline keywords as a syntax-highlight chip (`{rounded.xs}` corner, no padding-y, 12px padding-x). Also used as the squiggly footer divider stroke. Never a button background."}, {"name": "Hot Pink", "hex": "#fa7faa", "group": "Brand & Accent", "token": "accent-pink", "role": "Secondary punctuation color used for sticker outlines, chart points, and supporting accents — never on buttons, never on type at body size."}, {"name": "Violet Link", "hex": "#6a5fc1", "group": "Brand & Accent", "token": "accent-violet", "role": "Inline link color when emphasis is needed beyond underline."}, {"name": "Deep Violet", "hex": "#422082", "group": "Brand & Accent", "token": "accent-violet-deep", "role": "The select-dropdown fill on contact forms; also used on spotlight cards inside dark sections."}, {"name": "Mid Violet", "hex": "#79628c", "group": "Brand & Accent", "token": "accent-violet-mid", "role": "Tag-chip fill and faint accent on dark surfaces."}, {"name": "Dark Canvas", "hex": "#1f1633", "group": "Surface", "token": "surface-canvas-dark", "role": "Hero, product, and feature-page background. Carries the deepest atmospheric weight."}, {"name": "Night", "hex": "#150f23", "group": "Surface", "token": "surface-night", "role": "Cards on dark canvas, code blocks, and the \"featured\" pricing tier."}, {"name": "Light Canvas", "hex": "#ffffff", "group": "Surface", "token": "surface-canvas-light", "role": "Pricing, contact, and dense-reference page background."}, {"name": "Surface Press Light", "hex": "#f0f0f0", "group": "Surface", "token": "surface-press-light", "role": "The pressed/active fill of inverted buttons on dark surfaces."}, {"name": "Hairline Violet", "hex": "#362d59", "group": "Surface", "token": "hairline-violet", "role": "1px borders on dark cards."}, {"name": "Hairline Cool", "hex": "#cfcfdb", "group": "Surface", "token": "hairline-cool", "role": "1px borders on text inputs and form fields."}, {"name": "Hairline Cloud", "hex": "#e5e7eb", "group": "Surface", "token": "hairline-cloud", "role": "Pricing-table dividers and pricing-card borders on light canvas."}, {"name": "On Primary", "hex": "#ffffff", "group": "Text", "token": "on-primary", "role": "All text on dark canvas, all CTA labels on filled dark buttons."}, {"name": "Ink", "hex": "#1f1633", "group": "Text", "token": "ink", "role": "Body text on light canvas; identical hex to the dark canvas, repurposed as type."}, {"name": "Ink Press", "hex": "#1a1a1a", "group": "Text", "token": "ink-press", "role": "Reserved for the pressed/active state of inverted buttons."}], "tokens": {"colors": {"prim