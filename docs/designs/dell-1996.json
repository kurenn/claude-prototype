{"slug": "dell-1996", "name": "Dell (1996)", "category": "Retro Web · DESIGN.md Nostalgia", "summary": "Catalog-era enterprise web. Literal black page frame, flat color-block \"ribbon cards\", chunky Helvetica-Black titles over Times Roman body, and hand-cut GIF stickers (NEW! bursts, award seals, beveled product photos).", "description": "An inspired interpretation of Dell.com's 1996 design language — a catalog-era enterprise web design built around a literal black page frame, vivid flat color-block \"ribbon cards\" tinted in sage, salmon, periwinkle, sky, peach and lime, chunky Helvetica-Black display titles, Times Roman body copy, and an entire visual vocabulary of pre-Photoshop hand-cut GIF stickers (NEW! bursts, award seals, beveled product photos).", "colors": [{"name": "Dell Red", "hex": "#e91d2a", "group": "Brand & Accent", "token": "primary", "role": "The brand's signature red. Reserved for the homepage CTA panel (\"At Dell.com, we'll help you find the right system…\"), the top-right phone number, and the PC Magazine Readers' Choice seal ring. Never used as a card body fill."}, {"name": "Dell Yellow", "hex": "#fcc20f", "group": "Brand & Accent", "token": "yellow-sticker", "role": "Sticker yellow — the \"BUY a DELL\" tab in the top banner, and the angled \"NEW!\" bursts overlapping new product rows."}, {"name": "Dell Purple", "hex": "#6a26a4", "group": "Brand & Accent", "token": "purple-stripe", "role": "The accent stripe behind the lowercase \".com\" / \"DELL\" wordmark text — appears inside the \"BUY a DELL\" sticker chrome only."}, {"name": "Frame Ink", "hex": "#000000", "group": "Surface", "token": "frame-ink", "role": "Pure black. The page frame, the top banner background, button fills, and all 1 px ribbon-card hairlines."}, {"name": "Canvas", "hex": "#ffffff", "group": "Surface", "token": "canvas", "role": "True white inside the frame. The page surface, the ribbon-card title-bar fill, and the icon-label nav backdrop."}, {"name": "Ink", "hex": "#000000", "group": "Text", "token": "ink", "role": "Body text, headings, link copy before visit. Pure black; no warm-near-black softening in 1996."}, {"name": "Link", "hex": "#0000ee", "group": "Text", "token": "link", "role": "Classic Mosaic / Netscape 3.x default link blue. Underlined inline anchors (\"Copyright\", \"(Terms of Use)\", inline \"from Dell's award-winning service and support teams\")."}, {"name": "Olive", "hex": "#8e8a25", "group": "Ribbon-Card Tint Family", "token": "tint-olive", "role": "\"DIMENSION DESKTOPS\" eyebrow block"}, {"name": "Sage", "hex": "#b3bd95", "group": "Ribbon-Card Tint Family", "token": "tint-sage", "role": "Latitude Notebooks ribbon body"}, {"name": "Salmon", "hex": "#d77a7a", "group": "Ribbon-Card Tint Family", "token": "tint-salmon", "role": "\"OPTIPLEX DESKTOP SYSTEMS\" eyebrow + GX Series body"}, {"name": "Peach", "hex": "#e6915d", "group": "Ribbon-Card Tint Family", "token": "tint-peach", "role": "Dimension card body + OptiPlex Gs body"}, {"name": "Lime", "hex": "#c0d4a7", "group": "Ribbon-Card Tint Family", "token": "tint-lime", "role": "OptiPlex G Series body"}, {"name": "Sky", "hex": "#9ab6c8", "group": "Ribbon-Card Tint Family", "token": "tint-sky", "role": "Dellware ribbon body"}, {"name": "Steel", "hex": "#a5b8c0", "group": "Ribbon-Card Tint Family", "token": "tint-steel", "role": "Dimension XPS Pro ribbon body"}, {"name": "Periwinkle", "hex": "#8c9ae0", "group": "Ribbon-Card Tint Family", "token": "tint-periwinkle", "role": "PowerEdge ribbon body"}], "tokens": {"colors": {"primary": "#e91d2a", "on-primary": "#ffffff", "canvas": "#ffffff", "surface": "#ffffff", "ink": "#000000", "frame-ink": "#000000", "yellow-sticker": "#fcc20f", "purple-stripe": "#6a26a4", "link": "#0000ee", "tint-olive": "#8e8a25", "tint-sage": "#b3bd95", "tint-salmon": "#d77a7a", "tint-peach": "#e6915d", "tint-lime": "#c0d4a7", "tint-sky": "#9ab6c8", "tint-steel": "#a5b8c0", "tint-periwinkle": "#8c9ae0"}, "rounded": {"none": "0px", "full": "9999px"}, "spa