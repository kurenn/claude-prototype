{"slug": "airbnb", "name": "Airbnb", "category": "E-commerce & Retail", "summary": "Travel marketplace. Warm coral accent, photography-driven, rounded UI", "description": "A warm, generous consumer marketplace anchored on a clean white canvas and Airbnb Rausch (#ff385c), the single brand voltage that carries every primary CTA, search-button orb, and rating dot. Type runs Airbnb Cereal VF at modest weights — display sits at 22–28px in weight 500/600 rather than the heavy 700+ that fintech and enterprise systems use; the brand trusts photography and generous whitespace over typographic muscle. Three product entries (Homes, Experiences, Services) sit in the top nav with hand-illustrated 32-icon glyphs and \"NEW\" badges, signaling a marketplace expansion rather than a feature dump. Pill-shaped search bars (`{rounded.full}`), softly rounded property cards (`{rounded.lg}` ~14px), and 32px button radii read as friendly and human — there is no hard corner anywhere except the body grid.", "colors": [{"name": "Rausch", "hex": "#ff385c", "group": "Brand & Accent", "token": "primary", "role": "The single brand color. Used for primary CTA backgrounds (Reserve, Continue), the search orb, the heart save state on property cards, and inline brand links. The most recognizable color in consumer travel."}, {"name": "Rausch Active", "hex": "#e00b41", "group": "Brand & Accent", "token": "primary-active", "role": "The press / pointer-down variant — slightly more saturated. Used on `{component.button-primary-active}`."}, {"name": "Rausch Disabled", "hex": "#ffd1da", "group": "Brand & Accent", "token": "primary-disabled", "role": "A pale tint used on disabled CTAs."}, {"name": "Luxe Purple", "hex": "#460479", "group": "Brand & Accent", "token": "luxe", "role": "Sub-brand accent for Airbnb Luxe. Only appears inside Luxe-branded surfaces — never in mainline marketing."}, {"name": "Plus Magenta", "hex": "#92174d", "group": "Brand & Accent", "token": "plus", "role": "Sub-brand accent for Airbnb Plus. Same scoping as Luxe — sub-product only."}, {"name": "Canvas", "hex": "#ffffff", "group": "Surface", "token": "canvas", "role": "The default page floor for every public page. Airbnb does not have a dark mode on the public web."}, {"name": "Surface Soft", "hex": "#f7f7f7", "group": "Surface", "token": "surface-soft", "role": "The lightest fill — used on disabled fields, sub-nav hover backgrounds, and the inline search filter band."}, {"name": "Surface Strong", "hex": "#f2f2f2", "group": "Surface", "token": "surface-strong", "role": "Slightly heavier fill — circular icon-button surface (e.g., the breadcrumb back-arrow and listing toolbar buttons)."}, {"name": "Hairline", "hex": "#dddddd", "group": "Hairlines & Borders", "token": "hairline", "role": "The default 1px border tone — search bar dividers, table separators, footer column splitters, card 1px borders."}, {"name": "Hairline Soft", "hex": "#ebebeb", "group": "Hairlines & Borders", "token": "hairline-soft", "role": "A lighter divider used on long-scrolling editorial body separators."}, {"name": "Border Strong", "hex": "#c1c1c1", "group": "Hairlines & Borders", "token": "border-strong", "role": "A heavier stroke used on disabled outline buttons and form input outlines after focus."}, {"name": "Ink", "hex": "#222222", "group": "Text", "token": "ink", "role": "The dominant text color on light surfaces. Display headlines, body paragraphs, primary nav links, and most inline link text. Never pure black."}, {"name": "Body", "hex": "#3f3f3f", "group": "Text", "token": "body", "role": "A secondary running-text color used inside long-form review and amenity copy where ink would feel too heavy."}, {"name": "Muted", "hex": "#6a6a6a", "group": "Text", "token": "muted", "role": "Sub-titles inside city link blocks (\"Cottage rentals\", \"Villa rentals\"), inactive product-tab labels, footer category sub-labels, \"View all\" links."}, {"name": "Muted Soft", "hex": "#929292", "group": "Text", "token": "muted-soft", "role": "Disabled link text. Used very sparingly."}, {"name": "Star Rating", "hex": "#222222", "group": "Text", "token": "star-rating", "role": "The same ink token — Airbnb's star icon and \"4.81\" rating numbers all render in ink rather than a yellow/gold color, which is a deliberate brand choice (yellow stars feel cheap in travel context)."}, {"name": "On Primary", "hex": "#ffffff", "group": "Text", "token": "on-primary", "role": "White text on Rausch CTAs."}, {"name": "Error", "hex": "#c13515", "group": "Semantic", "token": "primary-error-text", "role": "Inline error text for form validation. Distinct from Rausch — slightly darker, more saturated red."}, {"name": "Error Hover", "hex": "#b32505", "group": "Semantic", "token": "primary-error-text-hover", "role": "Darkens on link hover."}, {"name": "Legal Link Blue", "hex": "#428bff", "group": "Semantic", "token": "legal-link", "role": "Inline links inside legal copy (Privacy, Terms). Only used inside the legal sub-band."}, {"name": "Scrim", "hex": "#000000", "group": "Scrim", "token": "scrim", "role": "The global modal backdrop tone — date picker, login dialog, language picker. Stored as the base hex; opacity is applied at render time."}], "tokens": {"colors": {"primary": "#ff385c", "primary-active": "#e00b41", "primary-disabled": "#ffd1da", "primary-error-text": "#c13515", "primary-error-text-hover": "#b32505", "luxe": "#460479", "plus": "#92174d", "ink": "#222222", "body": "#3f3f3f", "muted": "#6a6a6a", "muted-soft": "#929292", "hairline": "#dddddd", "hairline-soft": "#ebebeb", "border-strong": "#c1c1c1", "canvas": "#ffffff", "surface-soft": "#f7f7f7", "surface-card": "#ffffff", "surface-strong": "#f2f2f2", "on-primary": "#ffffff", "on-dark": "#ffffff", "legal-link": "#428bff", "star-rating": "#222222", "scrim": "#000000"}, "rounded": {"none": "0px", "xs": "4px", "sm": "8px", "md": "14px", "lg": "20px", "xl": "32px", "full": "9999px"}, "spacing": {"xxs": "2px", "xs": "4px", "sm": "8px", "md": "12px", "base": "16px", "l