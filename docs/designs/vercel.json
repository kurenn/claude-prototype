{"slug": "vercel", "name": "Vercel", "category": "Developer Tools & IDEs", "summary": "Frontend deployment platform. Black and white precision, Geist font", "description": "An inspired interpretation of Vercel's design language — a developer-platform brand whose surface is a stark black-and-ink duet on near-white canvas, broken at hero scale by a multi-color mesh gradient (cyan / blue / magenta / amber) that acts as the entire decorative system, paired with a custom geometric sans for headlines and a monospaced caption face for technical labels.", "colors": [{"name": "Ink", "hex": "#171717", "group": "Brand & Accent", "token": "primary", "role": "The single primary CTA color. Black-near-pure ink that carries every Sign Up pill, every footer CTA, the dark-band polarity-flip. Used as text color throughout the page on light surfaces. (Resolved from `--ds-gray-1000`.)"}, {"name": "Cyan", "hex": "#50e3c2", "group": "Brand & Accent", "token": "cyan", "role": "A signature mint-cyan used in the brand gradient and inside Geist-system spotlight tokens. Visible inside the hero gradient stops."}, {"name": "Highlight Pink", "hex": "#ff0080", "group": "Brand & Accent", "token": "highlight-pink", "role": "The brand's highlight magenta, used as the high-saturation stop in the preview-gradient pair."}, {"name": "Violet", "hex": "#7928ca", "group": "Brand & Accent", "token": "violet", "role": "The deep purple used as the start of the preview-gradient and inside developer-console highlights."}, {"name": "Link Blue", "hex": "#0070f3", "group": "Brand & Accent", "token": "link", "role": "The brand's primary link color and the legacy `--geist-success` semantic."}, {"name": "Canvas", "hex": "#ffffff", "group": "Surface", "token": "canvas", "role": "The pure-white card / dialog / modal surface."}, {"name": "Canvas Soft", "hex": "#fafafa", "group": "Surface", "token": "canvas-soft", "role": "The default page background — 98 % white. Almost every section sits on this tone."}, {"name": "Canvas Soft 2", "hex": "#f5f5f5", "group": "Surface", "token": "canvas-soft-2", "role": "A slightly deeper inset surface for \"code editor inner background\", template-card hover states, and dropdown menus."}, {"name": "Hairline", "hex": "#ebebeb", "group": "Surface", "token": "hairline", "role": "1 px dividers — table rows, card borders, input borders."}, {"name": "Hairline Strong", "hex": "#a1a1a1", "group": "Surface", "token": "hairline-strong", "role": "The 500-level gray, used as the slightly-stronger divider on light bands and as the deemphasised text color."}, {"name": "Ink", "hex": "#171717", "group": "Text", "token": "ink", "role": "Every heading and body paragraph on light surfaces."}, {"name": "Body", "hex": "#4d4d4d", "group": "Text", "token": "body", "role": "Secondary text — sub-headings, body captions, nav-link inactive text, footer column body."}, {"name": "Mute", "hex": "#888888", "group": "Text", "token": "mute", "role": "Lowest-priority text — placeholder text, fine print, low-key labels."}, {"name": "On Primary", "hex": "#ffffff", "group": "Text", "token": "on-primary", "role": "All text on `{colors.primary}` surfaces."}, {"name": "Success / Link", "hex": "#0070f3", "group": "Semantic", "token": "success", "role": "The brand's legacy success indicator doubles as the primary link color. Visible underline-on-hover for inline body links."}, {"name": "Link Deep", "hex": "#0761d1", "group": "Semantic", "token": "link-deep", "role": "The pressed / visited tone for inline links."}, {"name": "Link Bg Soft", "hex": "#d3e5ff", "group": "Semantic", "token": "link-bg-soft", "role": "Soft pastel blue fill for \"what's new\" pill banners and informational badges."}, {"name": "Error", "hex": "#ee0000", "group": "Semantic", "token": "error", "role": "Validation red for destructive actions and form errors."}, {"name": "Error Soft", "hex": "#f7d4d6", "group": "Semantic", "token": "error-soft", "role": "Soft pastel red for destructive-state backgrounds."}, {"name": "Error Deep", "hex": "#c50000", "group": "Semantic", "token": "error-deep", "role": "Pressed / deep destructive state."}, {"name": "Warning", "hex": "#f5a623", "group": "Semantic", "token": "warning", "role": "Caution / pending status indicator."}, {"name": "Warning Soft", "hex": "#ffefcf", "group": "Semantic", "token": "warning-soft", "role": "Background + pressed variants."}, {"name": "Develop", "hex": "#007cf0", "group": "Brand Gradient", "token": "gradient-develop-start", "role": "the blue-to-teal pair used to mark the \"deploy\" / \"develop\" rhythm."}, {"name": "Preview", "hex": "#7928ca", "group": "Brand Gradient", "token": "gradient-preview-start", "role": "the violet-to-pink pair used for \"preview\" surfaces."}, {"name": "Ship", "hex": "#ff4d4d", "group": "Brand Gradient", "token": "gradient-ship-start", "role": "the coral-to-amber pair used for \"ship\" surfaces."}], "tokens": {"colors": {"primary": "#171717", "on-primary": "#ffffff", "ink": "#171717", "body": "#4d4d4d", "mute": "#888888", "hairline": "#ebebeb", "hairline-strong": "#a1a1a1", "canvas": "#ffffff", "canvas-soft": "#fafafa", "canvas-soft-2": "#f5f5f5", "link": "#0070f3", "link-deep": "#0761d1", "link-bg-soft": "#d3e5ff", "success": "#0070f3", "error": "#ee0000", "error-soft": "#f7d4d6", "error-deep": "#c50000", "warning": "#f5a623", "warning-soft": "#ffefcf", "warning-deep": "#ab570a", "violet": "#7928ca", "violet-soft": "#d8ccf1", "violet-deep": "#4c2889", "cyan": "#50e3c2", "cyan-soft": "#aaffec", "cyan-deep": "#29bc9b", "highlight-pink": "#ff0080", "highlight-magenta": "#eb367f", "gradient-develop-start": "#007cf0", "gradient-develop-end": "#00dfd8", "gradient-preview-start": "#7928ca", "gradient-preview-end": "#ff0080", "gradient-ship-start": "#ff4d4d", "gradient-ship-end": "#f9cb28", "selection-bg": "#171717", "selection-fg": "#f2f2f2"}, "rounded": {"none": "0px", "xs": "4px", "sm": "6px", "md": "8px", "lg": "12px", "xl": "16px", "pill-sm": "64px", "pill": "100px", "full": "9999px"}, "spacin