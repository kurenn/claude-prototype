{"slug": "resend", "name": "Resend", "category": "Productivity & SaaS", "summary": "Email API for developers. Minimal dark theme, monospace accents", "description": "|", "colors": [{"name": "Primary White", "hex": "#fcfdff", "group": "Brand & Accent", "token": "primary", "role": "the brand's de facto accent. Reserved for `{component.button-primary}` (white pill on black canvas), Domaine display headlines, and the active text colour. White is the loudest possible colour on this canvas — that's the signature."}, {"name": "Primary On", "hex": "#000000", "group": "Brand & Accent", "token": "primary-on", "role": "label colour on top of `{colors.primary}` surfaces. Black text on white pill is the brand's CTA pattern."}, {"name": "Surface Light", "hex": "#f1f7fe", "group": "Brand & Accent", "token": "surface-light", "role": "a subtle blue-tinted off-white used as the active/pressed state of `{component.button-primary}`."}, {"name": "Canvas", "hex": "#000000", "group": "Surface", "token": "canvas", "role": "the default page background. True black, never near-black."}, {"name": "Surface Card", "hex": "#0a0a0c", "group": "Surface", "token": "surface-card", "role": "the standard inset card surface, just lighter than canvas to register a step up in elevation."}, {"name": "Surface Elevated", "hex": "#101012", "group": "Surface", "token": "surface-elevated", "role": "a second elevation step used on featured pricing tiers and ghost button surfaces."}, {"name": "Surface Deep", "hex": "#06060a", "group": "Surface", "token": "surface-deep", "role": "code window background — slightly cooler and darker than the canvas itself, suggesting depth via temperature."}, {"name": "Ink", "hex": "#fcfdff", "group": "Text", "token": "ink", "role": "primary text colour on the dark canvas. Faintly blue-cool to feel like printed paper rather than pure white pop."}, {"name": "Mute", "hex": "#a1a4a5", "group": "Text", "token": "mute", "role": "supporting text and inactive labels."}, {"name": "Ash", "he