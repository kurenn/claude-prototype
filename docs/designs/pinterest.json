{"slug": "pinterest", "name": "Pinterest", "category": "Media & Consumer Tech", "summary": "Visual discovery platform. Red accent, masonry grid, image-first", "description": "|", "colors": [{"name": "Pinterest Red", "hex": "#e60023", "group": "Brand & Accent", "token": "primary", "role": "the brand's only highly-saturated color. Sign-up CTAs, sticky top-nav anchor, active state in tab strips, and the brand wordmark."}, {"name": "Pinterest Red Pressed", "hex": "#cc001f", "group": "Brand & Accent", "token": "primary-pressed", "role": "pressed state for the primary button — a single notch deeper than brand red."}, {"name": "Canvas", "hex": "#ffffff", "group": "Surface", "token": "canvas", "role": "true white. The base surface for the primary nav, modals, feature cards, and content body."}, {"name": "Soft Surface", "hex": "#fbfbf9", "group": "Surface", "token": "surface-soft", "role": "faintly cream-tinted off-white used for the page body wash on the home page hero."}, {"name": "Surface Card", "hex": "#f6f6f3", "group": "Surface", "token": "surface-card", "role": "warm-cream card and pin-tile background. Carries category tiles, search-bar default fill, button-secondary default, and pin-card backgrounds."}, {"name": "Secondary BG", "hex": "#e5e5e0", "group": "Surface", "token": "secondary-bg", "role": "the gray-cream used for `{component.button-secondary}` (\"I already have an account\") fill — a notch deeper than `{colors.surface-card}`."}, {"name": "Secondary Pressed", "hex": "#c8c8c1", "group": "Surface", "token": "secondary-pressed", "role": "pressed state for the secondary button."}, {"name": "Surface Dark", "hex": "#262622", "group": "Surface", "token": "surface-dark", "role": "warm near-black used in the rare dark CTA strip on `create.pinterest.com`."}, {"name": "Hairline", "hex": "#dadad3", "group": "Surface", "token": "hairline", "role": "1px row dividers, footer column rules."}, {"name": "Hairline Soft", "hex": "#e5e5e0", "group": "Surface", "token": "hairline-