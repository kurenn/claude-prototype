{"slug": "wired", "name": "WIRED", "category": "Media & Consumer Tech", "summary": "Tech magazine. Paper-white broadsheet density, custom serif, ink-blue links", "description": "An inspired interpretation of Wired's design language — a flagship technology-magazine brand whose surface is a strict editorial duet of stark black wordmark on white canvas, anchored by a tall narrow custom display serif for hero headlines, a humanist serif body face for long-form reading, and a clean sans face for metadata; layout reads like a printed magazine ported to the web with very little marketing chrome.", "colors": [{"name": "Ink Black", "hex": "#000000", "group": "Brand & Accent", "token": "primary", "role": "The brand's only \"accent.\" Used for wordmark, headlines, CTAs, footer fill. Pure black, never softened."}, {"name": "Canvas", "hex": "#ffffff", "group": "Surface", "token": "canvas", "role": "The default page background."}, {"name": "Canvas Soft", "hex": "#f5f5f5", "group": "Surface", "token": "canvas-soft", "role": "Rare tint used for the comment-section background and search-result row hover states (not in the main page rhythm)."}, {"name": "Hairline", "hex": "#e0e0e0", "group": "Surface", "token": "hairline", "role": "1 px dividers between story rows. The brand's only \"line.\""}, {"name": "Ink", "hex": "#000000", "group": "Text", "token": "ink", "role": "Every headline, every body paragraph in BreveText."}, {"name": "Ink Soft", "hex": "#1a1a1a", "group": "Text", "token": "ink-soft", "role": "A near-black variant used for caption-strong / footer link emphasis."}, {"name": "Body", "hex": "#757575", "group": "Text", "token": "body", "role": "Secondary metadata — bylines, timestamps, supporting body lines."}, {"name": "Link", "hex": "#057dbc", "group": "Semantic", "token": "link", "role": "The inline body-link blue. Used only inside long-form article body copy, never on UI buttons or navigation."}], "tokens": {"colors": {"primary": "#000000", "on-primary": "#ffffff", "ink"