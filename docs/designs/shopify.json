{"slug": "shopify", "name": "Shopify", "category": "E-commerce & Retail", "summary": "E-commerce platform. Dark-first cinematic, neon green accent, ultra-light display type", "description": "An inspired interpretation of Shopifi's design language — a cinematic commerce platform that runs two parallel design tracks. The marketing-hero and product-narrative pages live on near-black canvases with full-bleed photography of merchants, giant Neue Haas Grotesk display type at thin weights, and a single black-pill CTA stroked in white. The transactional pages (pricing, signup, dashboards) flip to a cream-mint canvas with pastel aloe and pistachio greens, the same pill button vocabulary, and Inter for UI body. The two tracks share typographic DNA but diverge sharply in canvas polarity — and that choice is the brand.", "colors": [{"name": "Aloe", "hex": "#c1fbd4", "group": "Brand & Accent", "token": "aloe-10", "role": "The featured-tier and \"growth\" accent. Used as a pill button background on light surfaces and as a feature-card fill in the pricing comparison band."}, {"name": "Pistachio", "hex": "#d4f9e0", "group": "Brand & Accent", "token": "pistachio-10", "role": "Softer than aloe; used as a wide section band fill on the light track to signal a different category of feature without leaving the green family."}, {"name": "Cool Link Tones", "hex": "#9dabad", "group": "Brand & Accent", "token": "link-cool-1", "role": "Muted footer / tertiary link colors used on dark surfaces to create a quiet hierarchy below the primary white type."}, {"name": "Canvas Night", "hex": "#000000", "group": "Surface", "token": "canvas-night", "role": "Pure black hero, cinematic feature pages, footer."}, {"name": "Canvas Night Elevated", "hex": "#0a0a0a", "group": "Surface", "token": "canvas-night-elevated", "role": "Cards on cinematic surfaces, video frames."}, {"name": "Surface Elevated Dark", "hex": "#1e2c31", "group": "Surface", "token": "surface-elevated-dark", "role": "Dark teal-shifted surface used on a small subset of dark cards to introduce subtle depth without breaking the black."}, {"name": "Canvas Light", "hex": "#ffffff", "group": "Surface", "token": "canvas-light", "role": "Pricing, signup, comparison tables."}, {"name": "Canvas Cream", "hex": "#fbfbf5", "group": "Surface", "token": "canvas-cream", "role": "Slightly warm off-white used on the pricing-page background canvas — invisibly different from `#ffffff` but adds editorial warmth."}, {"name": "Hairline Light", "hex": "#e4e4e7", "group": "Surface", "token": "hairline-light", "role": "1px borders on light cards, table dividers."}, {"name": "Hairline Dark", "hex": "#1e2c31", "group": "Surface", "token": "hairline-dark", "role": "1px borders on the rare dark cards that have visible chrome."}, {"name": "Shade-30", "hex": "#d4d4d8", "group": "Shade Ladder", "token": "shade-30", "role": "Tag / chip background on light, footer hairline on dark."}, {"name": "Shade-40", "hex": "#a1a1aa", "group": "Shade Ladder", "token": "shade-40", "role": "Tertiary text on light, secondary text on dark."}, {"name": "Shade-50", "hex": "#71717a", "group": "Shade Ladder", "token": "shade-50", "role": "Secondary text on light."}, {"name": "Shade-60", "hex": "#52525b", "group": "Shade Ladder", "token": "shade-60", "role": "Tertiary text on light, deep on dark."}, {"name": "Shade-70", "hex": "#3f3f46", "group": "Shade Ladder", "token": "shade-70", "role": "Pressed-state of the primary pill button; deep dark surface accent."}, {"name": "Ink", "hex": "#000000", "group": "Text", "token": "ink", "role": "All text on light canvas."}, {"name": "On Primary", "hex": "#ffffff", "group": "Text", "token": "on-primary", "role": "All text on dark canvas + filled-pill labels."}], "tokens": {"colors": {"primary": "#000000", "ink": "#000000", "on-primary": "#ffffff", "on-dark": "#ffffff", "canvas-night": "#000000", "canvas-night-elevated": "#0a0a0a", "canvas-light": "#ffffff", "canvas-cream": "#fbfbf5", "surface-elevated-dark": "#1e2c3