{"slug": "ollama", "name": "Ollama", "category": "AI & LLM Platforms", "summary": "Run LLMs locally. Terminal-first, monochrome simplicity", "description": "|", "colors": [{"name": "Pure Black", "hex": "#000000", "group": "Brand & Accent", "token": "primary", "role": "the brand. Every primary CTA, every black pill, every link in the nav, and every solid icon. There is no other \"brand color.\""}, {"name": "Ink Deep", "hex": "#090909", "group": "Brand & Accent", "token": "ink-deep", "role": "pressed-state black for the primary pill — a single notch below pure."}, {"name": "Canvas", "hex": "#ffffff", "group": "Surface", "token": "canvas", "role": "the page itself. Nearly every surface in the system."}, {"name": "Soft Surface", "hex": "#fafafa", "group": "Surface", "token": "surface-soft", "role": "install-snippet pill background, search pill, secondary chip backgrounds, alternating row fill where one is needed."}, {"name": "Surface Dark", "hex": "#171717", "group": "Surface", "token": "surface-dark", "role": "the dark \"Max\" pricing card and dark CTA strips. The single inverted surface in the system."}, {"name": "Hairline", "hex": "#e5e5e5", "group": "Surface", "token": "hairline", "role": "1px card border, divider line above footer, divider between FAQ rows."}, {"name": "Hairline Strong", "hex": "#d4d4d4", "group": "Surface", "token": "hairline-strong", "role": "rare slightly stronger divider where extra separation is needed (e.g., between unrelated FAQ groups)."}, {"name": "Ink", "hex": "#000000", "group": "Text", "token": "ink", "role": "all headlines, primary nav links, button text on light surfaces, prices on pricing cards."}, {"name": "Charcoal", "hex": "#525252", "group": "Text", "token": "charcoal", "role": "list-item text and disabled-state secondary copy."}, {"name": "Body", "hex": "#737373", "group": "Text", "token": "body", "role": "default body color for paragraph copy, FAQ answers, footer link text — the system's most-used text color after pure black."}