{"slug": "bmw-m", "name": "BMW M", "category": "Automotive", "summary": "Performance automotive. Motorsport-inspired contrast, M color accents, precision-driven layout", "description": "A motorsport-engineering interface anchored on a near-black canvas with white BMW Type Next Latin display headlines in confident UPPERCASE. The brand carries no decorative voltage — its energy comes from full-bleed automotive photography (cars on tracks, driver-cockpit shots, carbon-fiber detail) and the iconic M tricolor stripe (light blue → dark blue → red) used sparingly as a brand signature on logos, dividers, and motorsport chrome. Type stays light to medium weight to feel European-engineered, never American-bombastic.", "colors": [{"name": "Primary", "hex": "#ffffff", "group": "Brand & Accent", "token": "primary", "role": "The system's primary type and CTA color. Used for h1/h2/h3 display, body text on dark, and primary button labels (the buttons themselves are transparent or canvas-colored — the white text + outline IS the button)."}, {"name": "M Blue Light", "hex": "#0066b1", "group": "Brand & Accent", "token": "m-blue-light", "role": "The first stop in the M tricolor stripe. Used on M-badge accents and motorsport chrome."}, {"name": "M Blue Dark", "hex": "#1c69d4", "group": "Brand & Accent", "token": "m-blue-dark", "role": "The middle stop. The same hex as `{colors.bmw-blue}` — BMW's heritage corporate blue, repurposed as the middle band of the M stripe."}, {"name": "M Red", "hex": "#e22718", "group": "Brand & Accent", "token": "m-red", "role": "The third stop. The signature M-power red, used in the stripe and on motorsport-pace callouts."}, {"name": "Electric Blue", "hex": "#0653b6", "group": "Brand & Accent", "token": "electric-blue", "role": "A separate electric-vehicle accent used on M xDrive electric model pages. Distinct from the heritage blue — feels colder, more digital."}, {"name": "Canvas", "hex": "#000000", "group": "Surface", "token": "canvas", "role": "The default page floor across every marketing surface. True black."}, {"name": "Surface Soft", "hex": "#0d0d0d", "group": "Surface", "token": "surface-soft", "role": "A barely-different-from-black used for spec table cells and footer-adjacent strips."}, {"name": "Surface Card", "hex": "#1a1a1a", "group": "Surface", "token": "surface-card", "role": "Cards, secondary buttons, icon-button backgrounds."}, {"name": "Surface Elevated", "hex": "#262626", "group": "Surface", "token": "surface-elevated", "role": "One step lighter, used for nested cards inside dark bands."}, {"name": "Carbon Gray", "hex": "#2b2b2b", "group": "Surface", "token": "carbon-gray", "role": "Carbon-fiber-inspired surface tone used on technical-spec cards."}, {"name": "Hairline", "hex": "#3c3c3c", "group": "Hairlines & Borders", "token": "hairline", "role": "The 1px divider tone on dark surfaces. Used between body sections, between table rows, around card outlines."}, {"name": "Hairline Strong", "hex": "#262626", "group": "Hairlines & Borders", "token": "hairline-strong", "role": "Same hex as `{colors.surface-elevated}` — borders feel like one-step elevations rather than ink lines."}, {"name": "Ink / On Dark", "hex": "#ffffff", "group": "Text", "token": "on-dark", "role": "All headline and primary text on dark canvas."}, {"name": "Body", "hex": "#bbbbbb", "group": "Text", "token": "body", "role": "Default running-text color (slightly cooler than pure white). Used for body paragraphs and secondary metadata."}, {"name": "Body Strong", "hex": "#e6e6e6", "group": "Text", "token": "body-strong", "role": "Emphasized body / lead paragraph."}, {"name": "Muted", "hex": "#7e7e7e", "group": "Text", "token": "muted", "role": "Footer links, breadcrumbs, captions."}, {"name": "Warning", "hex": "#f4b400", "group": "Semantic", "token": "warning", "role": "Used very sparingly on technical-warning callouts."}, {"name": "Success", "hex": "#0fa336", "group": "Semantic", "token": "success", "role": "Order-confirmation states (rare on marketing surfaces)."}], "tokens": {"colors": {"primary": "#ffffff", "ink": "#ffffff", "body": "#bbbbbb", "body-strong": "#e6e6e6", "muted": "#7e7e7e", "hairline": "#3c3c3c", "hairline-strong": "#262626", "canvas": "#000000", "surface-card": "#1a1a1a", "surface-elevated": "#262626", "surface-soft": "#0d0d0d", "on-primary": "#000000", "on-dark": "#ffffff", "m-blue-light": "#0066b1", "m-blue-dark": "#1c69d4", "m-red": "#e22718", "bmw-blue": "#1c69d4", "electric-blue": "#0653b6", "carbon-gray": "#2b2b2b", "warning": "#f4b400", "success": "#0fa336"}, "rounded": {"none": "0px", "xs": "2px", "sm": "4px", "md": "6px", "full": "9999px"}, "spacing": {"xxs": "4px", "xs": "8px", "sm": "12px", "md": "16px", "lg": "24px", "xl": "40px", "xxl": "64px", "section": "96px"}}, "typography": {"display-xl": {"fontFamily": "BMWTypeNextLatin, sans-serif", "fontSize": "80px", "fontWeight": "700", "lineHeight": "1", "letterSpacing": "0", "preview": null}, "display-lg": {"fontFamily": "BMWTypeNextLatin, sans-serif", "fontSize": "56px", "fontWeight": "700", "lineHeight": "1.05", "letterSpacing": "0", "preview": null}, "display-md": {"fontFamily": "BMWTypeNextLatin, sans-serif", "fontSize": "40px", "fontWeight": "700", "lineHeight": "1.1", "letterSpacing": "0", "preview": null}, "display-sm": {"fontFamily": "BMWTypeNextLatin, sans-serif", "fontSize": "32px", "fontWeight": "700", "lineHeight": "1.15", "letterSpacing": "0", "preview": null}, "title-lg": {"fontFamily": "BMWTypeNextLatin, sans-serif", "fontSize": "24px", "fontWeight": "700", "lineHeight": "1.3", "letterSpacing": "0", "preview": null}, "title-md": {"fontFamily": "BMWTypeNextLatin, sans-serif", "fontSize": "20px", "fontWeight": "400", "lineHeight": "1.4", "letterSpacing": "0", "preview": null}, "title-sm": {"fontFamily": "BMWTypeNextLatin, sans-serif", "fontSize": "18px", "fontWeight": "400", "lineHeight": "1.4", "letterSpacing": "0", "preview": null}, "label-uppercase": {"fontFamily": "BMWTypeNextLatin, sans-serif", "fontSize"